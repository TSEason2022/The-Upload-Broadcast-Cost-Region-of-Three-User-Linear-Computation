UploadBroadcast.ConditionedResidualBridges.canonicalReduction_all_tripod_bridges : ∀ {K : Type u_1} {P₁ : Type u_4}
  {P₂ : Type u_5} {P₃ : Type u_6} {D : Type u_7} [inst : Field K] [inst_1 : AddCommGroup P₁]
  [inst_2 : _root_.Module K P₁] [inst_3 : AddCommGroup P₂] [inst_4 : _root_.Module K P₂] [inst_5 : AddCommGroup P₃]
  [inst_6 : _root_.Module K P₃] [inst_7 : AddCommGroup D] [inst_8 : _root_.Module K D]
  (task : UploadBroadcast.Task K (UploadBroadcast.ResidualUpload.Ambient P₁ P₂ P₃ D))
  (h₀ : task.A 0 = UploadBroadcast.ResidualUpload.A₁ K P₁ P₂ P₃ D)
  (h₁ : task.A 1 = UploadBroadcast.ResidualUpload.A₂ K P₁ P₂ P₃ D)
  (h₂ : task.A 2 = UploadBroadcast.ResidualUpload.A₃ K P₁ P₂ P₃ D),
  let res := UploadBroadcast.ResidualTaskAssembly.canonicalReduction task h₀ h₁ h₂;
  let a := UploadBroadcast.ResidualTaskAssembly.canonicalReductionBridge task h₀ h₁ h₂;
  LinearMap.range a.v ⊔ LinearMap.range a.r ≤ res.U 2 ⊔ res.U 0 ⊓ res.U 1 ∧
    LinearMap.range a.v ⊔ LinearMap.range a.r ≤ res.U 1 ⊔ res.U 2 ⊓ res.U 0 ∧
      LinearMap.range a.v ⊔ LinearMap.range a.r ≤ res.U 0 ⊔ res.U 1 ⊓ res.U 2
UploadBroadcast.ConditionedResidualBridges.canonicalReduction_conditioned_retained_bounds : ∀ {K : Type u_1}
  {E : Type u_2} {P₁ : Type u_4} {P₂ : Type u_5} {P₃ : Type u_6} {D : Type u_7} [inst : Field K]
  [inst_1 : AddCommGroup E] [inst_2 : _root_.Module K E] [inst_3 : AddCommGroup P₁] [inst_4 : _root_.Module K P₁]
  [inst_5 : AddCommGroup P₂] [inst_6 : _root_.Module K P₂] [inst_7 : AddCommGroup P₃] [inst_8 : _root_.Module K P₃]
  [inst_9 : AddCommGroup D] [inst_10 : _root_.Module K D] [inst_11 : Finite K] [inst_12 : FiniteDimensional K E]
  [inst_13 : FiniteDimensional K P₁] [inst_14 : FiniteDimensional K P₂] [inst_15 : FiniteDimensional K P₃]
  [inst_16 : FiniteDimensional K D] (task : UploadBroadcast.Task K (UploadBroadcast.ResidualUpload.Ambient P₁ P₂ P₃ D))
  (h₀ : task.A 0 = UploadBroadcast.ResidualUpload.A₁ K P₁ P₂ P₃ D)
  (h₁ : task.A 1 = UploadBroadcast.ResidualUpload.A₂ K P₁ P₂ P₃ D)
  (h₂ : task.A 2 = UploadBroadcast.ResidualUpload.A₃ K P₁ P₂ P₃ D) {n : ℕ} {M : UploadBroadcast.Three → Type u_8}
  {B : Type u_9} [inst_17 : (i : UploadBroadcast.Three) → Fintype (M i)]
  [inst_18 : (i : UploadBroadcast.Three) → MeasurableSpace (M i)]
  [inst_19 : ∀ (i : UploadBroadcast.Three), DiscreteMeasurableSpace (M i)] (om : UploadBroadcast.Task K E),
  (∀ (i : UploadBroadcast.Three), om.U i = ⊤) →
    ∀
      (code :
        (UploadBroadcast.Profile.directSum om
              (UploadBroadcast.ResidualTaskAssembly.canonicalReduction task h₀ h₁ h₂)).Code
          n M B),
      let res := UploadBroadcast.ResidualTaskAssembly.canonicalReduction task h₀ h₁ h₂;
      let μ := ProbabilityTheory.uniformOn Set.univ;
      let obs := fun A =>
        UploadBroadcast.observe K (E × UploadBroadcast.ConditionedResidualBridges.CanonicalAmbient task h₀ h₁ h₂) A;
      let Ω := obs (⊤.prod ⊥);
      let W := fun i => obs (⊥.prod (res.A i));
      let msg := fun i x => code.encode i (obs ((om.A i).prod (res.A i)) x);
      let q := Real.log ↑(Nat.card K);
      let Γ :=
        ↑n *
          (↑(Module.finrank K ↥⋯) + ↑(Module.finrank K ↥⋯) +
              ↑(Module.finrank K ↥(UploadBroadcast.ResidualTaskAssembly.used₃ task)) +
            ↑(Module.finrank K ↥(UploadBroadcast.ResidualTaskAssembly.selectedTrimData task h₀ h₁ h₂).activeRows));
      let J :=
        ![I[msg 1 : msg 2|fun x => (W 0 x, Ω x);μ] / q, I[msg 0 : msg 2|fun x => (W 1 x, Ω x);μ] / q,
          I[msg 0 : msg 1|fun x => ⋯;μ] / q];
      ∀ (i j : UploadBroadcast.Three), i ≠ j → Γ + J i + J j ≤ ⋯ / q + ⋯ / q + H[msg 2 | Ω ; μ] / q
