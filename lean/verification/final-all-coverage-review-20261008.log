UploadBroadcast.NonzeroSameChartPermutations.pathPerm_exhaustive : Function.Surjective
  UploadBroadcast.R2PermutedMenus.pathPerm
UploadBroadcast.NonzeroSameChartPermutations.same_chart_all_permuted_choices : ∀ {K F : Type} [inst : Field K]
  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] [inst_3 : FiniteDimensional K F] [inst_4 : Fintype K],
  3 ≤ Fintype.card K →
    ∀ (T : UploadBroadcast.Task K F),
      UploadBroadcast.TaskDecomposition.Indecomposable (UploadBroadcast.EdgeExtraction.configuration T).spaces ⊤ →
        ∀ (k : Fin 6) (g : UploadBroadcast.NonzeroDefectProfile.Family) (n : ℕ),
          1 ≤ n →
            UploadBroadcast.NonzeroFamilyRanks.Dimensions
                (UploadBroadcast.Profile.reindexTask (UploadBroadcast.R2PermutedMenus.pathPerm k) T) g n →
              ∀ (choice : UploadBroadcast.Three),
                (∀ (r : Fin 6),
                    UploadBroadcast.Profile.entry T (Sum.inl r) =
                      ↑(UploadBroadcast.NonzeroDefectProfile.fullFirst g n
                          (UploadBroadcast.R2PermutedMenus.inverseFirst k r))) ∧
                  (∀ (i ell : UploadBroadcast.Three),
                      2 * UploadBroadcast.Profile.entry T (Sum.inr (i, ell)) =
                        ↑(UploadBroadcast.NonzeroDefectProfile.doubledSecond g n)) ∧
                    ∃ P,
                      ∃ (hg : T.LocallyGenerated P),
                        T.RelayFeasible P ∧
                          Module.finrank K ↥P =
                              UploadBroadcast.NonzeroDefectProfile.fullAmbient g n -
                                UploadBroadcast.NonzeroDefectProfile.codimension g ∧
                            ↑(Module.finrank K ↥P) = T.uploadOptimum ∧
                              ∑ i, Module.finrank K ↥(P ⊓ T.A i) = Module.finrank K ↥P ∧
                                (∀ (r : Fin 6),
                                    UploadBroadcast.Profile.entry
                                        (UploadBroadcast.NonzeroDefectRelays.inducedTask T P hg) (Sum.inl r) =
                                      ↑(UploadBroadcast.NonzeroDefectProfile.fullFirst g n
                                            (UploadBroadcast.R2PermutedMenus.inverseFirst k r)) +
                                        ↑(UploadBroadcast.NonzeroSameChartMenus.menuIncrement g choice
                                            (UploadBroadcast.R2PermutedMenus.inverseFirst k r))) ∧
                                  ∀ (i ell : UploadBroadcast.Three),
                                    2 *
                                        UploadBroadcast.Profile.entry
                                          (UploadBroadcast.NonzeroDefectRelays.inducedTask T P hg) (Sum.inr (i, ell)) =
                                      ↑(UploadBroadcast.NonzeroDefectProfile.doubledSecond g n)
UploadBroadcast.Omniscience.block_cost_lower : ∀ {K : Type u_1} {V : Type u_2} {X₁ : Type u_3} {X₂ : Type u_4}
  {X₃ : Type u_5} [inst : Field K] [inst_1 : AddCommGroup V] [inst_2 : _root_.Module K V] [inst_3 : AddCommGroup X₁]
  [inst_4 : _root_.Module K X₁] [inst_5 : AddCommGroup X₂] [inst_6 : _root_.Module K X₂] [inst_7 : AddCommGroup X₃]
  [inst_8 : _root_.Module K X₃] [inst_9 : FiniteDimensional K V] [inst_10 : FiniteDimensional K X₁]
  [inst_11 : FiniteDimensional K X₂] [inst_12 : FiniteDimensional K X₃] [inst_13 : Finite K] (L : ℕ),
  0 < L →
    ∀ {r₁ r₂ r₃ : ℕ}
      (c : UploadBroadcast.Omniscience.Code K (Fin L → V) (Fin L → X₁) (Fin L → X₂) (Fin L → X₃) r₁ r₂ r₃),
      UploadBroadcast.Omniscience.optimum ≤ c.alphabetCost / ↑L
UploadBroadcast.Omniscience.exists_code : ∀ {K : Type u_1} {V : Type u_2} [inst : Field K] [inst_1 : AddCommGroup V]
  [inst_2 : _root_.Module K V] {X₁ : Type u_5} {X₂ : Type u_6} {X₃ : Type u_7} [inst_3 : AddCommGroup X₁]
  [inst_4 : _root_.Module K X₁] [inst_5 : AddCommGroup X₂] [inst_6 : _root_.Module K X₂] [inst_7 : AddCommGroup X₃]
  [inst_8 : _root_.Module K X₃] [inst_9 : FiniteDimensional K V] [inst_10 : FiniteDimensional K X₁]
  [inst_11 : FiniteDimensional K X₂] [inst_12 : FiniteDimensional K X₃] (r₁ r₂ r₃ : ℕ),
  Module.finrank K V + Module.finrank K X₁ ≤ r₂ + r₃ →
    Module.finrank K V + Module.finrank K X₂ ≤ r₁ + r₃ →
      Module.finrank K V + Module.finrank K X₃ ≤ r₁ + r₂ →
        Nonempty (UploadBroadcast.Omniscience.Code K V X₁ X₂ X₃ r₁ r₂ r₃)
