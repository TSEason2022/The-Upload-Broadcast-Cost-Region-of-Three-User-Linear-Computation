include README.md LICENSE LICENSING.md SECURITY.md
include pyproject.toml build_release.py .gitignore
recursive-include three_user_codes *.py py.typed
recursive-include tests *.py
recursive-include examples *.py *.json
recursive-include benchmarks *.py *.json *.ini
recursive-include docs *.md *.pdf *.svg *.mmd
recursive-include validation *.json
recursive-include validation *.md
recursive-include tools *.py
recursive-include typing_examples *.py
recursive-include .github *.yml
prune build
prune dist
global-exclude __pycache__ *.py[cod] .DS_Store
