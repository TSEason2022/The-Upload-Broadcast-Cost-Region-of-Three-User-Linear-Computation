            (UploadBroadcast.EdgeExtraction.configuration
                (UploadBroadcast.FiniteComponentCoordinates.componentTask T.pairFreeChart.componentResidual P e
                  i)).spaces
            ⊤) ∧
        (∀ (i : Fin n) (j : UploadBroadcast.Three),
            (UploadBroadcast.FiniteComponentCoordinates.componentTask T.pairFreeChart.componentResidual P e i).A j =
              Submodule.comap (P i).subtype (T.pairFreeChart.componentResidual.A j)) ∧
          (∀ (i : Fin n) (j : UploadBroadcast.Three),
              (UploadBroadcast.FiniteComponentCoordinates.componentTask T.pairFreeChart.componentResidual P e i).U j =
                Submodule.comap (P i).subtype (T.pairFreeChart.componentResidual.U j)) ∧
            (∀ (i : Fin n),
                UploadBroadcast.ResidualComponentAdditivity.ActiveResidual
                  (UploadBroadcast.FiniteComponentCoordinates.componentTask T.pairFreeChart.componentResidual P e i)) ∧
              T.pairFreeChart.componentResidual.uploadOptimum =
                  UploadBroadcast.ResidualComponentAdditivity.uploadValue T.pairFreeChart.componentResidual ∧
                (∀ (i : Fin n),
                    (UploadBroadcast.FiniteComponentCoordinates.componentTask T.pairFreeChart.componentResidual P e
                          i).uploadOptimum =
                      UploadBroadcast.ResidualComponentAdditivity.uploadValue
                        (UploadBroadcast.FiniteComponentCoordinates.componentTask T.pairFreeChart.componentResidual P e
                          i)) ∧
                  T.pairFreeChart.componentResidual.uploadOptimum =
                      ∑ i,
                        (UploadBroadcast.FiniteComponentCoordinates.componentTask T.pairFreeChart.componentResidual P e
                            i).uploadOptimum ∧
                    ∑ i, Module.finrank K ↥(P i) =
                      Module.finrank K
                        (UploadBroadcast.ResidualUpload.Ambient
                          ↥(UploadBroadcast.ResidualTaskAssembly.used₁ T.pairFreeChart.toTask)
                          ↥(UploadBroadcast.ResidualTaskAssembly.used₂ T.pairFreeChart.toTask)
                          ↥(UploadBroadcast.ResidualTaskAssembly.used₃ T.pairFreeChart.toTask)
                          ↥(UploadBroadcast.ResidualTaskAssembly.finalDemandData T.pairFreeChart.toTask ⋯ ⋯
                                ⋯).activeRows)
