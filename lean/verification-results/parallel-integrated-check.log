                        (UploadBroadcast.ResidualProfiles.permutedIncrement
                          UploadBroadcast.NonzeroDefectProfile.Family.O k)) ∧
                ∀ (n : ℕ)
                  (e : F ≃ₗ[K] UploadBroadcast.ResonantEndomorphisms.Ambient K (UploadBroadcast.JordanResonance.V K n)),
                  UploadBroadcast.Profile.mapTask e T = UploadBroadcast.ResonantRelay.jordanTask K n →
                    UploadBroadcast.ResidualProfiles.OptimalExactMenu T UploadBroadcast.ResonantFiniteAssembly.increment
UploadBroadcast.ResidualRowShape.canonicalReduction_scalar_upload_exact : ∀ {K : Type u_1} {P₁ : Type u_2}
  {P₂ : Type u_3} {P₃ : Type u_4} {D : Type u_5} [inst : Field K] [inst_1 : Finite K] [inst_2 : AddCommGroup P₁]
  [inst_3 : _root_.Module K P₁] [inst_4 : AddCommGroup P₂] [inst_5 : _root_.Module K P₂] [inst_6 : AddCommGroup P₃]
  [inst_7 : _root_.Module K P₃] [inst_8 : AddCommGroup D] [inst_9 : _root_.Module K D]
  [inst_10 : FiniteDimensional K P₁] [inst_11 : FiniteDimensional K P₂] [inst_12 : FiniteDimensional K P₃]
  [inst_13 : FiniteDimensional K D] (task : UploadBroadcast.Task K (UploadBroadcast.ResidualUpload.Ambient P₁ P₂ P₃ D))
  (h₀ : task.A 0 = UploadBroadcast.ResidualUpload.A₁ K P₁ P₂ P₃ D)
  (h₁ : task.A 1 = UploadBroadcast.ResidualUpload.A₂ K P₁ P₂ P₃ D)
  (h₂ : task.A 2 = UploadBroadcast.ResidualUpload.A₃ K P₁ P₂ P₃ D),
  UploadBroadcast.ResidualTaskAssembly.pureRows₁ task ⊓ UploadBroadcast.ResidualTaskAssembly.pureRows₂ task ⊓
        UploadBroadcast.ResidualTaskAssembly.pureRows₃ task =
      ⊥ →
    let res := UploadBroadcast.ResidualTaskAssembly.canonicalReduction task h₀ h₁ h₂;
    let d :=
      Module.finrank K ↥(UploadBroadcast.ResidualTaskAssembly.used₁ task) +
            Module.finrank K ↥(UploadBroadcast.ResidualTaskAssembly.used₂ task) +
          Module.finrank K ↥(UploadBroadcast.ResidualTaskAssembly.used₃ task) +
        Module.finrank K ↥(UploadBroadcast.ResidualTaskAssembly.selectedTrimData task h₀ h₁ h₂).activeRows;
    ∃ r c, ∑ i, r i = d ∧ c.toCode.uploadCost = ↑d ∧ c.toCode.broadcastCost ≤ ↑d
UploadBroadcast.ResidualRowShape.exists_exact_row_completion : ∀ {K : Type u_1} {P₁ : Type u_2} {P₂ : Type u_3}
  {P₃ : Type u_4} [inst : Field K] [inst_1 : AddCommGroup P₁] [inst_2 : _root_.Module K P₁] [inst_3 : AddCommGroup P₂]
  [inst_4 : _root_.Module K P₂] [inst_5 : AddCommGroup P₃] [inst_6 : _root_.Module K P₃] {D : Type u_9}
  [inst_7 : AddCommGroup D] [inst_8 : _root_.Module K D] [inst_9 : FiniteDimensional K P₁]
  [inst_10 : FiniteDimensional K P₂] [inst_11 : FiniteDimensional K P₃] [inst_12 : FiniteDimensional K D]
  (task : UploadBroadcast.Task K (UploadBroadcast.ResidualUpload.Ambient P₁ P₂ P₃ D)),
  task.A 0 = UploadBroadcast.ResidualUpload.A₁ K P₁ P₂ P₃ D →
    task.A 1 = UploadBroadcast.ResidualUpload.A₂ K P₁ P₂ P₃ D →
      task.A 2 = UploadBroadcast.ResidualUpload.A₃ K P₁ P₂ P₃ D →
        UploadBroadcast.ResidualTaskAssembly.pureRows₁ task ⊓ UploadBroadcast.ResidualTaskAssembly.pureRows₂ task ⊓
              UploadBroadcast.ResidualTaskAssembly.pureRows₃ task =
            ⊥ →
          ∀ (W : Submodule K D),
            IsCompl
                (UploadBroadcast.ResidualTaskAssembly.pureRows₁ task ⊔
                    UploadBroadcast.ResidualTaskAssembly.pureRows₂ task ⊔
                  UploadBroadcast.ResidualTaskAssembly.pureRows₃ task)
                W →
              let S :=
                UploadBroadcast.ResidualTaskAssembly.pureRows₁ task ⊔
                    UploadBroadcast.ResidualTaskAssembly.pureRows₂ task ⊔
                  UploadBroadcast.ResidualTaskAssembly.pureRows₃ task;
              ∃ f Prow,
                let Q :=
                  UploadBroadcast.ResidualRowShape.privateSpace ⊔ Prow ⊔
                    Submodule.map UploadBroadcast.ResidualTaskAssembly.embedV W;
                (∀ (i : UploadBroadcast.Three), Submodule.map (↑f) (task.A i) = task.A i) ∧
                  (∀ (t : D × D), f (0, t) = (0, t)) ∧
                    (∀ (i : UploadBroadcast.Three), Submodule.map (↑f) (task.U i) ≤ task.A i ⊔ Q) ∧
                      task.LocallyGenerated Q ∧
                        Prow ≤ ⊥.prod (S.prod S) ∧
                          task.LocallyGenerated Prow ∧
                            Module.finrank K ↥Prow = Module.finrank K ↥S ∧
                              Disjoint Prow (Submodule.map UploadBroadcast.ResidualTaskAssembly.embedV W) ∧
                                Disjoint UploadBroadcast.ResidualRowShape.privateSpace
                                    (Prow ⊔ Submodule.map UploadBroadcast.ResidualTaskAssembly.embedV W) ∧
                                  Module.finrank K ↥Q =
                                    Module.finrank K P₁ + Module.finrank K P₂ + Module.finrank K P₃ +
                                        Module.finrank K ↥S +
                                      Module.finrank K ↥W
UploadBroadcast.ResidualRowShape.row_completion_paper : ∀ {K : Type u_1} {P₁ : Type u_2} {P₂ : Type u_3} {P₃ : Type u_4}
  {D : Type u_5} {E : Type u_6} [inst : Field K] [inst_1 : AddCommGroup P₁] [inst_2 : _root_.Module K P₁]
  [inst_3 : AddCommGroup P₂] [inst_4 : _root_.Module K P₂] [inst_5 : AddCommGroup P₃] [inst_6 : _root_.Module K P₃]
  [inst_7 : AddCommGroup D] [inst_8 : _root_.Module K D] [inst_9 : AddCommGroup E] [inst_10 : _root_.Module K E]
  [inst_11 : FiniteDimensional K P₁] [inst_12 : FiniteDimensional K P₂] [inst_13 : FiniteDimensional K P₃]
  [inst_14 : FiniteDimensional K D] [inst_15 : Finite K]
  (task : UploadBroadcast.Task K (UploadBroadcast.ResidualUpload.Ambient P₁ P₂ P₃ D)),
  task.A 0 = UploadBroadcast.ResidualUpload.A₁ K P₁ P₂ P₃ D →
    task.A 1 = UploadBroadcast.ResidualUpload.A₂ K P₁ P₂ P₃ D →
      task.A 2 = UploadBroadcast.ResidualUpload.A₃ K P₁ P₂ P₃ D →
        UploadBroadcast.ResidualTaskAssembly.pureRows₁ task ⊓ UploadBroadcast.ResidualTaskAssembly.pureRows₂ task ⊓
              UploadBroadcast.ResidualTaskAssembly.pureRows₃ task =
            ⊥ →
          ∀ (W : Submodule K D),
            IsCompl
                (UploadBroadcast.ResidualTaskAssembly.pureRows₁ task ⊔
                    UploadBroadcast.ResidualTaskAssembly.pureRows₂ task ⊔
                  UploadBroadcast.ResidualTaskAssembly.pureRows₃ task)
                W →
              let S :=
                UploadBroadcast.ResidualTaskAssembly.pureRows₁ task ⊔
                    UploadBroadcast.ResidualTaskAssembly.pureRows₂ task ⊔
                  UploadBroadcast.ResidualTaskAssembly.pureRows₃ task;
              let n :=
                Module.finrank K P₁ + Module.finrank K P₂ + Module.finrank K P₃ + Module.finrank K ↥S +
                  Module.finrank K ↥W;
              ∃ f Prow,
                let Q :=
                  UploadBroadcast.ResidualRowShape.privateSpace ⊔ Prow ⊔
                    Submodule.map UploadBroadcast.ResidualTaskAssembly.embedV W;
                (∀ (i : UploadBroadcast.Three), Submodule.map (↑f) (task.A i) = task.A i) ∧
                  (∀ (t : D × D), f (0, t) = (0, t)) ∧
                    (∀ (t : D × D) (z : E), (f.prodCongr (LinearEquiv.refl K E)) ((0, t), z) = ((0, t), z)) ∧
                      (∀ (i : UploadBroadcast.Three), Submodule.map (↑f) (task.U i) ≤ task.A i ⊔ Q) ∧
                        task.LocallyGenerated Q ∧
                          Prow ≤ ⊥.prod (S.prod S) ∧
                            Module.finrank K ↥Prow = Module.finrank K ↥S ∧
                              (∃ b owner, ∀ (j : Fin (Module.finrank K ↥Prow)), ↑(b j) ∈ task.A (owner j)) ∧
                                Disjoint Prow (Submodule.map UploadBroadcast.ResidualTaskAssembly.embedV W) ∧
                                  Disjoint UploadBroadcast.ResidualRowShape.privateSpace
                                      (Prow ⊔ Submodule.map UploadBroadcast.ResidualTaskAssembly.embedV W) ∧
                                    Module.finrank K ↥Q = n ∧
                                      ∃ r c, ∑ i, r i = n ∧ ⋯.uploadCost ≤ ↑n ∧ ⋯.broadcastCost ≤ ↑n
