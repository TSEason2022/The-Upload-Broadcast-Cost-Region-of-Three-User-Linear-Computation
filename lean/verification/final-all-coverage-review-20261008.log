  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] [inst_3 : FiniteDimensional K F] (T : UploadBroadcast.Task K F)
  (θ : K),
  θ ≠ 0 →
    θ ≠ 1 →
      (∀ (i j : UploadBroadcast.Three),
          i ≠ j →
            UploadBroadcast.condRank
                ((UploadBroadcast.Profile.directSum T (UploadBroadcast.LiteralThetaBlocks.D.task θ)).U i ⊓
                  (UploadBroadcast.Profile.directSum T (UploadBroadcast.LiteralThetaBlocks.D.task θ)).U j)
                ((UploadBroadcast.Profile.directSum T (UploadBroadcast.LiteralThetaBlocks.D.task θ)).A j) =
              UploadBroadcast.condRank (T.U i ⊓ T.U j) (T.A j) + 1) ∧
        ∀ (ell : UploadBroadcast.Three),
          UploadBroadcast.condRank
              ((UploadBroadcast.Profile.directSum T (UploadBroadcast.LiteralThetaBlocks.D.task θ)).U 0 ⊓
                  (UploadBroadcast.Profile.directSum T (UploadBroadcast.LiteralThetaBlocks.D.task θ)).U 1 ⊓
                (UploadBroadcast.Profile.directSum T (UploadBroadcast.LiteralThetaBlocks.D.task θ)).U 2)
              ((UploadBroadcast.Profile.directSum T (UploadBroadcast.LiteralThetaBlocks.D.task θ)).A ell) =
            UploadBroadcast.condRank (T.U 0 ⊓ T.U 1 ⊓ T.U 2) (T.A ell)
