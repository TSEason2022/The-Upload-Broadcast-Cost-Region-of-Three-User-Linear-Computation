UploadBroadcast.ResidualComponentAdditivity.scalar_upload_exact : ∀ {K : Type u_1} {F : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] [inst_3 : Finite K] [inst_4 : FiniteDimensional K F]
