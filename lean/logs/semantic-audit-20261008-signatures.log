UploadBroadcast.ResidualConverse.explicit_residual_retained_bound.{u_3, u_4, u_5, u_6, u_7, u_8, u_9, u_10}
  {K : Type u_3} {P₁ : Type u_4} {P₂ : Type u_5} {P₃ : Type u_6} {T : Type u_7} {L : Type u_8} [Field K] [Finite K]
  [AddCommGroup P₁] [Module K P₁] [AddCommGroup P₂] [Module K P₂] [AddCommGroup P₃] [Module K P₃] [AddCommGroup T]
  [Module K T] [AddCommGroup L] [Module K L] [FiniteDimensional K P₁] [FiniteDimensional K P₂] [FiniteDimensional K P₃]
  [FiniteDimensional K T] {n : ℕ} {M : UploadBroadcast.Three → Type u_9} {S : Type u_10}
  [(i : UploadBroadcast.Three) → MeasurableSpace (M i)] [∀ (i : UploadBroadcast.Three), DiscreteMeasurableSpace (M i)]
  (R : UploadBroadcast.SignalBridge.Data)
  (task : UploadBroadcast.Task K (UploadBroadcast.ResidualUpload.Ambient P₁ P₂ P₃ T)) (code : task.FiniteCode n M S)
  (hA₀ : task.A 0 = UploadBroadcast.ResidualUpload.A₁ K P₁ P₂ P₃ T)
  (hA₁ : task.A 1 = UploadBroadcast.ResidualUpload.A₂ K P₁ P₂ P₃ T)
  (hA₂ : task.A 2 = UploadBroadcast.ResidualUpload.A₃ K P₁ P₂ P₃ T) (hU₀ : task.U 0 = R.U₁) (hU₁ : task.U 1 = R.U₂)
  (hU₂ : task.U 2 = R.U₃)
  (split :
    (i : UploadBroadcast.Three) →
      UploadBroadcast.ResidualConverse.PrivateSplit task i
        (![LinearMap.range R.v, LinearMap.range R.r, LinearMap.range (R.r - R.v)] i)) :
  let μ := ProbabilityTheory.uniformOn Set.univ;
  let W := fun i => UploadBroadcast.observe K (UploadBroadcast.ResidualUpload.Ambient P₁ P₂ P₃ T) (task.A i);
  let upload := fun i x => code.encode i (W i x);
  ↑n * (↑(Module.finrank K P₁) + ↑(Module.finrank K P₂) + ↑(Module.finrank K P₃) + ↑(Module.finrank K T)) +
        I[upload 1 : upload 2|W 0;μ] / Real.log ↑(Nat.card K) +
      I[upload 0 : upload 2|W 1;μ] / Real.log ↑(Nat.card K) ≤
    H[upload 0 ; μ] / Real.log ↑(Nat.card K) + H[upload 1 ; μ] / Real.log ↑(Nat.card K) +
      H[upload 2 ; μ] / Real.log ↑(Nat.card K)
UploadBroadcast.GlobalUploadConverse.code_omniscience_entropy_bound.{u_1, u_2, u_3, u_4} {K : Type u_1} {F : Type u_2}
  [Field K] [AddCommGroup F] [Module K F] [Finite K] [FiniteDimensional K F] {n : ℕ}
  {M : UploadBroadcast.Three → Type u_3} {B : Type u_4} [(i : UploadBroadcast.Three) → Fintype (M i)]
  [(i : UploadBroadcast.Three) → MeasurableSpace (M i)] [∀ (i : UploadBroadcast.Three), DiscreteMeasurableSpace (M i)]
  (task : UploadBroadcast.Task K F) (g : UploadBroadcast.GlobalUploadConverse.Geometry task) (code : task.Code n M B) :
  let μ := ProbabilityTheory.uniformOn Set.univ;
  let obs := fun A => UploadBroadcast.observe K F A;
  let msg := fun i x => code.encode i (obs (task.A i) x);
  2 * H[obs (g.R 0 ⊔ g.R 1 ⊔ g.R 2) ; μ] - (H[obs (g.R 0) ; μ] + H[obs (g.R 1) ; μ] + H[obs (g.R 2) ; μ]) +
      max
        (max (H[obs g.O ; μ] - H[obs (g.S 0) ; μ])
          (max (H[obs g.O ; μ] - H[obs (g.S 1) ; μ]) (H[obs g.O ; μ] - H[obs (g.S 2) ; μ])))
        ((H[obs g.O ; μ] - H[obs (g.S 0) ; μ] + (H[obs g.O ; μ] - H[obs (g.S 1) ; μ]) +
            (H[obs g.O ; μ] - H[obs (g.S 2) ; μ])) /
          2) ≤
    H[msg 0 ; μ] + H[msg 1 ; μ] + H[msg 2 ; μ]
