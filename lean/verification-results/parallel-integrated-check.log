  [inst_8 : _root_.Module K X₃] [inst_9 : FiniteDimensional K V] [inst_10 : FiniteDimensional K X₁]
  [inst_11 : FiniteDimensional K X₂] [inst_12 : FiniteDimensional K X₃] [inst_13 : Finite K] (n : ℕ),
  ↑n = UploadBroadcast.Omniscience.optimum → ∃ r₁ r₂ r₃ c, c.alphabetCost = UploadBroadcast.Omniscience.optimum
