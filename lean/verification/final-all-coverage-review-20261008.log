UploadBroadcast.OmniscienceProfile.first_entry : ∀ {K : Type u_1} {F : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] [inst_3 : FiniteDimensional K F]
  (T : UploadBroadcast.Task K F),
  (∀ (i : UploadBroadcast.Three), T.U i = ⊤) →
    ∀ (p : Equiv.Perm UploadBroadcast.Three),
      UploadBroadcast.Profile.firstEntry T (p 0) (p 1) (p 2) = ↑(UploadBroadcast.condRank ⊤ (T.A (p 0)))
UploadBroadcast.OmniscienceProfile.relay_deficits : ∀ {K : Type u_1} {F : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] [inst_3 : FiniteDimensional K F]
  (T : UploadBroadcast.Task K F),
  (∀ (i : UploadBroadcast.Three), T.U i = ⊤) →
    ∀ (P : Submodule K F),
      T.RelayFeasible P →
        ∀ (i : UploadBroadcast.Three), UploadBroadcast.condRank P (T.A i ⊓ P) = UploadBroadcast.condRank ⊤ (T.A i)
UploadBroadcast.OmniscienceProfile.second_entry : ∀ {K : Type u_1} {F : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] [inst_3 : FiniteDimensional K F]
  (T : UploadBroadcast.Task K F),
  (∀ (i : UploadBroadcast.Three), T.U i = ⊤) →
    ∀ (p : Equiv.Perm UploadBroadcast.Three) (ell : UploadBroadcast.Three),
      2 * UploadBroadcast.Profile.secondEntry T (p 0) (p 1) (p 2) ell =
        ∑ i, ↑(UploadBroadcast.condRank ⊤ (T.A i)) - ↑(UploadBroadcast.condRank ⊤ (T.A ell))
UploadBroadcast.OmniscienceRelayProfile.entry_preserved : ∀ {K : Type u_1} {V : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup V] [inst_2 : _root_.Module K V] [inst_3 : FiniteDimensional K V]
  (T : UploadBroadcast.Task K V),
  (∀ (i : UploadBroadcast.Three), T.U i = ⊤) →
    ∀ (P : Submodule K V) (hg : T.LocallyGenerated P),
      T.RelayFeasible P →
        ∀ (r : UploadBroadcast.Profile.Index),
          UploadBroadcast.Profile.entry (T.inducedRelay P hg) r = UploadBroadcast.Profile.entry T r
UploadBroadcast.OppositeDemandExample.strict_subadditivity_example : ∀ (K : Type u_1) [inst : Field K]
  [inst_1 : Finite K],
  UploadBroadcast.broadcastOptimum (UploadBroadcast.OppositeDemandExample.first K).A
        (UploadBroadcast.OppositeDemandExample.first K).U =
      1 ∧
    UploadBroadcast.broadcastOptimum (UploadBroadcast.OppositeDemandExample.second K).A
          (UploadBroadcast.OppositeDemandExample.second K).U =
        1 ∧
      UploadBroadcast.broadcastOptimum (UploadBroadcast.OppositeDemandExample.combined K).A
            (UploadBroadcast.OppositeDemandExample.combined K).U =
          1 ∧
        UploadBroadcast.broadcastOptimum (UploadBroadcast.OppositeDemandExample.combined K).A
              (UploadBroadcast.OppositeDemandExample.combined K).U <
            UploadBroadcast.broadcastOptimum (UploadBroadcast.OppositeDemandExample.first K).A
                (UploadBroadcast.OppositeDemandExample.first K).U +
              UploadBroadcast.broadcastOptimum (UploadBroadcast.OppositeDemandExample.second K).A
                (UploadBroadcast.OppositeDemandExample.second K).U ∧
          ∃ c, (∀ (x : K × K →ₗ[K] K), c.encode x 0 = x (1, 0) + x (0, 1)) ∧ c.toBlockOne.cost = 1
UploadBroadcast.OptimalRelaySeparation.optimal_block_residual_sides_ambient : ∀ {K : Type u_1} {F : Type u_2}
  [inst : Field K] [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] [inst_3 : Finite K]
  [inst_4 : FiniteDimensional K F] (T : UploadBroadcast.Task K F) (L : ℕ),
  0 < L →
    ∀ (P : Submodule K (Fin L → F)),
      (T.blockPower L).LocallyGenerated P →
        (T.blockPower L).RelayFeasible P →
          Disjoint (T.A 0) (T.A 1) →
            Disjoint (T.A 0) (T.A 2) →
              Disjoint (T.A 1) (T.A 2) →
                ↑(Module.finrank K ↥P) = ↑L * T.uploadOptimum →
                  (iSupIndep fun i => P ⊓ UploadBroadcast.blockSubmodule L (T.A i)) ∧
                    P = ⨆ i, P ⊓ UploadBroadcast.blockSubmodule L (T.A i)
