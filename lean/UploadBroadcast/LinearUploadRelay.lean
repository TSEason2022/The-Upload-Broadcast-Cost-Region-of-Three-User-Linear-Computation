import UploadBroadcast.LinearCode
import UploadBroadcast.ScalarPaperEndpoints
import UploadBroadcast.ResidualOperational
import UploadBroadcast.OperationalBounds
import Mathlib.LinearAlgebra.Dual.Lemmas

/-! Extract the actual original-field coefficient relay of a scalar linear
code. The local coefficient maps are the transposes of its encoders, with
finite-dimensional double duals evaluated back in the users' side spaces. -/
namespace UploadBroadcast.Task.LinearCode
open Module
variable {K F : Type*} [Field K] [AddCommGroup F] [Module K F]
  [FiniteDimensional K F] {T : Task K F} {r : Three → ℕ} {s : ℕ}

/-- The actual encoder after removing the singleton block coordinate. -/
def scalarEncoder (c : T.LinearCode 1 r s) (i : Three) :
    (T.A i →ₗ[K] K) →ₗ[K] (Fin (r i) → K) :=
  (c.encode i).comp sourceOneEquiv.symm.toLinearMap

/-- Every linear combination of uploaded coordinates has an actual local
coefficient, obtained by the inverse evaluation equivalence. -/
noncomputable def uploadCoefficientMap (c : T.LinearCode 1 r s) (i : Three) :
    ((Fin (r i) → K) →ₗ[K] K) →ₗ[K] F :=
  (T.A i).subtype.comp
    ((evalEquiv K (T.A i)).symm.toLinearMap.comp (c.scalarEncoder i).dualMap)

/-- The space of actual coefficient rows uploaded by user i. -/
noncomputable def localUploadSpace (c : T.LinearCode 1 r s) (i : Three) : Submodule K F :=
  LinearMap.range (c.uploadCoefficientMap i)

/-- The relay consists exactly of sums of actual uploaded coefficient rows. -/
noncomputable def uploadRelay (c : T.LinearCode 1 r s) : Submodule K F :=
  ⨆ i, c.localUploadSpace i

theorem localUploadSpace_le_side (c : T.LinearCode 1 r s) (i : Three) :
    c.localUploadSpace i ≤ T.A i := by
  rintro _ ⟨f,rfl⟩
  exact Subtype.prop _

theorem localUploadSpace_le_uploadRelay (c : T.LinearCode 1 r s) (i : Three) :
    c.localUploadSpace i ≤ c.uploadRelay := le_iSup _ i

/-- Evaluation of an uploaded coefficient is precisely evaluation of the
corresponding linear combination of transmitted coordinates. -/
theorem uploadCoefficientMap_apply (c : T.LinearCode 1 r s) (i : Three)
    (f : (Fin (r i) → K) →ₗ[K] K) (x : F →ₗ[K] K) :
    x (c.uploadCoefficientMap i f) = f (c.scalarEncoder i (x.comp (T.A i).subtype)) := by
  change (x.comp (T.A i).subtype) ((evalEquiv K (T.A i)).symm
    ((c.scalarEncoder i).dualMap f)) = _
  rw [apply_evalEquiv_symm_apply]
  rfl

/-- Coordinate-by-coordinate coefficient extraction, including zero and
redundant coordinates in the nominal upload alphabet. -/
noncomputable def uploadRow (c : T.LinearCode 1 r s) (i : Three) (j : Fin (r i)) : F :=
  c.uploadCoefficientMap i (LinearMap.proj j)

theorem uploadRow_mem (c : T.LinearCode 1 r s) (i : Three) (j : Fin (r i)) :
    c.uploadRow i j ∈ c.localUploadSpace i := ⟨LinearMap.proj j,rfl⟩

theorem uploadRow_apply (c : T.LinearCode 1 r s) (i : Three) (j : Fin (r i))
    (x : Source K F 1) :
    x (c.uploadRow i j) 0 = c.encode i (observe K F (T.A i) x) j := by
  have h := c.uploadCoefficientMap_apply i (LinearMap.proj j) (sourceOneEquiv x)
  change x (c.uploadRow i j) 0 = c.encode i
    (sourceOneEquiv.symm (sourceOneEquiv (observe K F (T.A i) x))) j at h
  simpa only [LinearEquiv.symm_apply_apply] using h

/-- The coefficient space is exactly the span of the encoder's actual
coordinate rows, not a larger subspace chosen for feasibility. -/
theorem localUploadSpace_eq_span_rows (c : T.LinearCode 1 r s) (i : Three) :
    c.localUploadSpace i = Submodule.span K (Set.range (c.uploadRow i)) := by
  apply le_antisymm
  · rintro _ ⟨f,rfl⟩
    have hcoord (j : Fin (r i)) :
        (Pi.basisFun K (Fin (r i))).coord j = LinearMap.proj j := by
      ext a
      simp [Basis.coord_apply]
    have hf := (Pi.basisFun K (Fin (r i))).sum_dual_apply_smul_coord f
    simp_rw [hcoord] at hf
    have he := congrArg (c.uploadCoefficientMap i) hf
    simp only [map_sum,map_smul] at he
    rw [← he]
    apply Submodule.sum_mem
    intro j _
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j,rfl⟩)
  · exact Submodule.span_le.mpr (by rintro _ ⟨j,rfl⟩; exact c.uploadRow_mem i j)

/-- There are exactly as many independent local coefficient rows as there
are independent attained encoder coordinates. -/
theorem finrank_localUploadSpace (c : T.LinearCode 1 r s) (i : Three) :
    finrank K (c.localUploadSpace i) = finrank K (LinearMap.range (c.encode i)) := by
  unfold localUploadSpace uploadCoefficientMap
  rw [LinearMap.range_comp,LinearMap.range_comp]
  rw [← (Submodule.equivMapOfInjective (T.A i).subtype
    (T.A i).injective_subtype _).finrank_eq]
  rw [LinearEquiv.finrank_map_eq,LinearMap.finrank_range_dualMap_eq_finrank_range]
  exact congrArg (fun P : Submodule K (Fin (r i) → K) => finrank K P)
    (sourceOneEquiv.symm.range_comp (c.encode i))

/-- The extracted relay is generated by coefficients that their uploading
users actually know. -/
theorem uploadRelay_locallyGenerated (c : T.LinearCode 1 r s) :
    T.LocallyGenerated c.uploadRelay := by
  apply le_antisymm
  · apply iSup_le
    intro i
    exact (le_inf (c.localUploadSpace_le_uploadRelay i) (c.localUploadSpace_le_side i)).trans
      (le_iSup (fun j : Three => c.uploadRelay ⊓ T.A j) i)
  · exact iSup_le fun _ => inf_le_left

/-- An actual original-field relay basis can be assigned to users who
know its coefficients. This produces exactly dim P local scalar uploads. -/
theorem uploadRelay_basis (c : T.LinearCode 1 r s) :
    ∃ (b : Basis (Fin (finrank K c.uploadRelay)) K c.uploadRelay)
      (owner : Fin (finrank K c.uploadRelay) → Three),
      ∀ j, (b j : F) ∈ T.A (owner j) :=
  ResidualUpload.locally_generated_basis T.A c.uploadRelay c.uploadRelay_locallyGenerated

/-- If a source annihilates the extracted relay, all actual upload
coordinates vanish. -/
theorem encode_eq_zero_of_uploadRelay (c : T.LinearCode 1 r s)
    (x : Source K F 1) (hx : ∀ p ∈ c.uploadRelay, x p 0 = 0) (i : Three) :
    c.encode i (observe K F (T.A i) x) = 0 := by
  ext j
  rw [← c.uploadRow_apply i j x]
  exact hx _ (c.localUploadSpace_le_uploadRelay i (c.uploadRow_mem i j))

/-- Zero error forces every demanded coefficient into the sum of local side
information and the extracted relay. This uses a separating source, rather
than assuming coefficient-space feasibility. -/
theorem uploadRelay_feasible (c : T.LinearCode 1 r s) : T.RelayFeasible c.uploadRelay := by
  intro i u hu
  by_contra hn
  obtain ⟨f,hfu,hfz⟩ := (T.A i ⊔ c.uploadRelay).exists_dual_map_eq_bot_of_nmem hn inferInstance
  have hz (v : F) (hv : v ∈ T.A i ⊔ c.uploadRelay) : f v = 0 := by
    have hm : f v ∈ (T.A i ⊔ c.uploadRelay).map f := ⟨v,hv,rfl⟩
    rw [hfz] at hm
    exact hm
  let x : Source K F 1 := sourceOneEquiv.symm f
  have ha : observe K F (T.A i) x = 0 := by
    ext a j
    change f (a : F) = 0
    exact hz a ((show T.A i ≤ T.A i ⊔ c.uploadRelay from le_sup_left) a.property)
  have he : (fun j => c.encode j (observe K F (T.A j) x)) = 0 := by
    funext j
    exact c.encode_eq_zero_of_uploadRelay x (fun p hp => hz p ((show c.uploadRelay ≤ T.A i ⊔ c.uploadRelay from le_sup_right) hp)) j
  have hzero := c.zero_error x i
  rw [he,map_zero,ha,show ((0 : Fin s → K), (0 : T.A i →ₗ[K] (Fin 1 → K))) = 0 from rfl,
    map_zero] at hzero
  apply hfu
  exact (congrFun (LinearMap.congr_fun hzero ⟨u,hu⟩) 0).symm

/-- Over three users the relay dimension is bounded by the sum of actual
local coefficient dimensions, without counting nominal upload lengths. -/
theorem finrank_uploadRelay_le_sum (c : T.LinearCode 1 r s) :
    finrank K c.uploadRelay ≤ ∑ i, finrank K (c.localUploadSpace i) := by
  have h₁ := Submodule.finrank_add_le_finrank_add_finrank
    (c.localUploadSpace 0) (c.localUploadSpace 1 ⊔ c.localUploadSpace 2)
  have h₂ := Submodule.finrank_add_le_finrank_add_finrank
    (c.localUploadSpace 1) (c.localUploadSpace 2)
  have hP : c.uploadRelay = c.localUploadSpace 0 ⊔
      (c.localUploadSpace 1 ⊔ c.localUploadSpace 2) := by
    apply le_antisymm
    · apply iSup_le
      intro i
      fin_cases i
      · exact le_sup_left
      · exact le_sup_of_le_right le_sup_left
      · exact le_sup_of_le_right le_sup_right
    · exact sup_le (le_iSup _ 0) (sup_le (le_iSup _ 1) (le_iSup _ 2))
  rw [hP]
  simp only [Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero]
  change finrank K (c.localUploadSpace 0 ⊔ (c.localUploadSpace 1 ⊔ c.localUploadSpace 2) : Submodule K F) ≤
    finrank K (c.localUploadSpace 0) + (finrank K (c.localUploadSpace 1) + finrank K (c.localUploadSpace 2))
  omega

variable [Finite K]

/-- The sum of local coefficient dimensions equals actual attained upload
cost, even with redundant nominal coordinates. -/
theorem sum_finrank_localUploadSpace (c : T.LinearCode 1 r s) :
    (∑ i, (finrank K (c.localUploadSpace i) : ℝ)) = c.toCode.uploadCost := by
  simp [uploadCost_eq_rank,finrank_localUploadSpace]

/-- Any scalar linear code yields an actual locally generated feasible
coefficient relay whose dimension is no greater than its attained upload cost. -/
theorem finrank_uploadRelay_le_uploadCost (c : T.LinearCode 1 r s) :
    (finrank K c.uploadRelay : ℝ) ≤ c.toCode.uploadCost := by
  rw [← c.sum_finrank_localUploadSpace]
  exact_mod_cast c.finrank_uploadRelay_le_sum

/-- At the operational upload minimum there is no overlap wastage: the
extracted relay dimension is exactly the attained upload cost. -/
theorem finrank_uploadRelay_eq_of_optimal (c : T.LinearCode 1 r s)
    (hc : c.toCode.uploadCost = T.uploadOptimum) :
    (finrank K c.uploadRelay : ℝ) = T.uploadOptimum := by
  apply le_antisymm (c.finrank_uploadRelay_le_uploadCost.trans_eq hc)
  obtain ⟨owner,d,hd⟩ := ResidualOperational.finiteCode_of_local_relay T c.uploadRelay
    c.uploadRelay_locallyGenerated c.uploadRelay_feasible
  letI := d.finite_upload
  letI := d.finite_broadcast
  exact (d.toCode.uploadOptimum_le (by decide)).trans hd

/-- Minimal scalar uploads form independent local coefficient spaces in
the dimension sense: their summed dimensions equal the relay dimension. -/
theorem sum_finrank_eq_uploadRelay_of_optimal (c : T.LinearCode 1 r s)
    (hc : c.toCode.uploadCost = T.uploadOptimum) :
    (∑ i, finrank K (c.localUploadSpace i)) = finrank K c.uploadRelay := by
  have h := c.sum_finrank_localUploadSpace.trans (hc.trans
    (c.finrank_uploadRelay_eq_of_optimal hc).symm)
  exact_mod_cast h

end UploadBroadcast.Task.LinearCode
