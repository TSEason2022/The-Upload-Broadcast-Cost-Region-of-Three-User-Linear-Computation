  (S : UploadBroadcast.Task K V),
  UploadBroadcast.ResidualComponentAdditivity.ActiveResidual S →
    ∀ (O : UploadBroadcast.Task K W),
      (∀ (i : UploadBroadcast.Three), O.U i = ⊤) →
        ∀ (D : ℤ),
          UploadBroadcast.Profile.rankBound (UploadBroadcast.Profile.directSum S O) ≤ ↑D →
            ∃ P,
