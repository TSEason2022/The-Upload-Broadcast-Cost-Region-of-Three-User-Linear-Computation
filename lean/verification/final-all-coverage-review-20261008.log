UploadBroadcast.Allocation.aggregate_selection_paper_coordinates : ∀ {R : Type u_1} [inst : CommRing R]
  [inst_1 : LinearOrder R] [inst_2 : IsStrictOrderedRing R] (μ : Fin 10 → R) (s : Fin 6 → R),
  (∀ (t : Fin 10), 0 ≤ μ t) →
    (∀ (j : Fin 6), 0 ≤ s j) →
      μ 0 + 2 * μ 1 + μ 2 + μ 3 + μ 5 + μ 6 + μ 7 ≤ s 0 + s 5 →
        μ 0 + μ 1 + 2 * μ 2 + μ 3 + μ 4 + μ 6 + μ 8 ≤ s 1 + s 3 →
          2 * μ 0 + μ 1 + μ 2 + μ 4 + μ 5 + μ 6 + μ 9 ≤ s 2 + s 4 →
            (UploadBroadcast.Allocation.AggregateFeasible (UploadBroadcast.Allocation.paperOrdinaryMultiplicities μ)
                (μ 6) (UploadBroadcast.Allocation.paperCapacities s) ↔
              μ 6 ≤ s 0 + s 3 + s 4 ∧ μ 6 ≤ s 1 + s 2 + s 5)
UploadBroadcast.BinaryAdditionalMenuPermutations.additional_fits_permuted : ∀ {K F : Type} [inst : Field K]
  [inst_1 : Finite K] [inst_2 : AddCommGroup F] [inst_3 : _root_.Module K F] [inst_4 : FiniteDimensional K F]
  (T : UploadBroadcast.Task K F),
  UploadBroadcast.TaskDecomposition.Indecomposable (UploadBroadcast.EdgeExtraction.configuration T).spaces ⊤ →
    ∀ (p : Equiv.Perm UploadBroadcast.Three) (g : UploadBroadcast.NonzeroBinaryMenus.Kind),
      g ≠ UploadBroadcast.NonzeroBinaryMenus.Kind.T1 →
        g ≠ UploadBroadcast.NonzeroBinaryMenus.Kind.O →
          ∀ (n : ℕ),
            1 ≤ n →
              UploadBroadcast.NonzeroFamilyRanks.Dimensions (UploadBroadcast.Profile.reindexTask p T)
                  (UploadBroadcast.NonzeroBinaryMenus.family g) n →
                ∀ (c : Fin 6 → ℕ),
                  (∀ (a : UploadBroadcast.Three),
                      UploadBroadcast.BinaryMenuAllocation.charge (UploadBroadcast.NonzeroBinaryMenus.extraFamily g) a ≤
                        c (UploadBroadcast.BinaryMenuAllocation.pairLeft a) +
                          c (UploadBroadcast.BinaryMenuAllocation.pairRight a)) →
                    ∃ P,
                      ∃ (hl : T.LocallyGenerated P),
                        T.RelayFeasible P ∧
                          ↑(Module.finrank K ↥P) = T.uploadOptimum ∧
                            (∀ (r : Fin 6),
                                UploadBroadcast.Profile.entry
                                    (UploadBroadcast.Profile.reindexTask p
                                      (UploadBroadcast.NonzeroDefectRelays.inducedTask T P hl))
                                    (Sum.inl r) ≤
                                  UploadBroadcast.Profile.entry (UploadBroadcast.Profile.reindexTask p T) (Sum.inl r) +
                                    ↑(c r)) ∧
                              ∀ (r : UploadBroadcast.Three × UploadBroadcast.Three),
                                UploadBroadcast.Profile.entry
                                    (UploadBroadcast.Profile.reindexTask p
                                      (UploadBroadcast.NonzeroDefectRelays.inducedTask T P hl))
                                    (Sum.inr r) =
                                  UploadBroadcast.Profile.entry (UploadBroadcast.Profile.reindexTask p T) (Sum.inr r)
