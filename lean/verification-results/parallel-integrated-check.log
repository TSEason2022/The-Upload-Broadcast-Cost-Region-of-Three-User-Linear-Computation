UploadBroadcast.OptimalRelaySeparation.optimal_block_residual_sides_ambient : ∀ {K : Type u_1} {F : Type u_2}
  [inst : Field K] [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] [inst_3 : Finite K]
  [inst_4 : FiniteDimensional K F] (T : UploadBroadcast.Task K F) (L : ℕ),
  0 < L →
    ∀ (P : Submodule K (Fin L → F)),
      (T.blockPower L).LocallyGenerated P →
        (T.blockPower L).RelayFeasible P →
          Disjoint (T.A 0) (T.A 1) →
            Disjoint (T.A 0) (T.A 2) →
              Disjoint (T.A 1) (T.A 2) →
                ↑(Module.finrank K ↥P) = ↑L * T.uploadOptimum →
                  (iSupIndep fun i => P ⊓ UploadBroadcast.blockSubmodule L (T.A i)) ∧
                    P = ⨆ i, P ⊓ UploadBroadcast.blockSubmodule L (T.A i)
UploadBroadcast.RegularExactMenus.from_actual_regular : ∀ {K F : Type} [inst : Field K] [inst_1 : Finite K]
  [inst_2 : AddCommGroup F] [inst_3 : _root_.Module K F] [inst_4 : FiniteDimensional K F]
  (T : UploadBroadcast.Task K F),
  UploadBroadcast.ResidualComponentAdditivity.ActiveResidual T →
    UploadBroadcast.TaskDecomposition.Indecomposable (UploadBroadcast.EdgeExtraction.configuration T).spaces ⊤ →
      UploadBroadcast.ReflectionReduction.defect (UploadBroadcast.EdgeExtraction.configuration T).dimensionVector = 0 →
        Module.finrank K F < Module.finrank K ↥(T.A 0) + Module.finrank K ↥(T.A 1) + Module.finrank K ↥(T.A 2) →
          ∃ n,
            ∀ (m : UploadBroadcast.Three),
              ∃ P,
                ∃ (hl : T.LocallyGenerated P),
                  T.RelayFeasible P ∧
                    Module.finrank K ↥P = 3 * (n + 1) + 1 ∧
                      ↑(Module.finrank K ↥P) = T.uploadOptimum ∧
                        (∀ (r : Fin 6),
                            UploadBroadcast.Profile.entry (UploadBroadcast.NonzeroDefectRelays.inducedTask T P hl)
                                (Sum.inl r) =
                              UploadBroadcast.Profile.entry T (Sum.inl r) +
                                UploadBroadcast.ResonantRelay.increment m r) ∧
                          ∀ (i l : UploadBroadcast.Three),
                            UploadBroadcast.Profile.entry (UploadBroadcast.NonzeroDefectRelays.inducedTask T P hl)
                                (Sum.inr (i, l)) =
                              UploadBroadcast.Profile.entry T (Sum.inr (i, l))
UploadBroadcast.ResidualComponentAdditivity.canonical_rows_fully_active : ∀ {K : Type u_1} [inst : Field K]
  {P₁ : Type u_5} {P₂ : Type u_6} {P₃ : Type u_7} {D : Type u_8} [inst_1 : AddCommGroup P₁]
