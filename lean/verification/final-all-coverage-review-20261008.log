  (T : UploadBroadcast.Task K F),
  (∀ (i : UploadBroadcast.Three), Module.finrank K ↥(T.preResidual.pairKnown i) = T.intrinsicActivePairRank i) ∧
    (∀ (i : UploadBroadcast.Three), T.pairOmniscienceFactor.U i = ⊤) ∧
      (UploadBroadcast.ResidualTaskAssembly.used₁ T.pairFreeChart.activeResidual = ⊤ ∧
          UploadBroadcast.ResidualTaskAssembly.used₂ T.pairFreeChart.activeResidual = ⊤ ∧
            UploadBroadcast.ResidualTaskAssembly.used₃ T.pairFreeChart.activeResidual = ⊤) ∧
        (∀ (L : ℕ), T.achievableAt L = (T.pairFreeChart.withActivePairs T.pairOmniscienceFactor).achievableAt L) ∧
