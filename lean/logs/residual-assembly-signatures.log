UploadBroadcast.Task.pair_canonical_factorization_achievableAt_eq.{u_1, u_2} {K : Type u_1} {F : Type u_2} [Field K]
  [AddCommGroup F] [Module K F] [Finite K] [FiniteDimensional K F] (T : UploadBroadcast.Task K F) (n : ℕ) :
  T.achievableAt n = (UploadBroadcast.Profile.directSum T.pairOmniscienceFactor T.pairFreeChart.toTask).achievableAt n
UploadBroadcast.Task.pair_canonical_factorization_costRegion_eq.{u_1, u_2} {K : Type u_1} {F : Type u_2} [Field K]
  [AddCommGroup F] [Module K F] [Finite K] [FiniteDimensional K F] (T : UploadBroadcast.Task K F) :
  closure (⋃ i, T.achievableAt i) =
    closure (⋃ i, (UploadBroadcast.Profile.directSum T.pairOmniscienceFactor T.pairFreeChart.toTask).achievableAt i)
UploadBroadcast.Task.canonicalPairFreeResidual_sides.{u_1, u_2} {K : Type u_1} {F : Type u_2} [Field K] [AddCommGroup F]
  [Module K F] (T : UploadBroadcast.Task K F) :
  T.pairFreeChart.toTask.A 0 =
      UploadBroadcast.ResidualUpload.A₁ K ↥T.pairFreeChart.P₁ ↥T.pairFreeChart.P₂ ↥T.pairFreeChart.P₃
        ↥(T.pairFreeResidual.A 2 ⊓ (T.pairFreeResidual.A 0 ⊔ T.pairFreeResidual.A 1)) ∧
    T.pairFreeChart.toTask.A 1 =
        UploadBroadcast.ResidualUpload.A₂ K ↥T.pairFreeChart.P₁ ↥T.pairFreeChart.P₂ ↥T.pairFreeChart.P₃
          ↥(T.pairFreeResidual.A 2 ⊓ (T.pairFreeResidual.A 0 ⊔ T.pairFreeResidual.A 1)) ∧
      T.pairFreeChart.toTask.A 2 =
        UploadBroadcast.ResidualUpload.A₃ K ↥T.pairFreeChart.P₁ ↥T.pairFreeChart.P₂ ↥T.pairFreeChart.P₃
          ↥(T.pairFreeResidual.A 2 ⊓ (T.pairFreeResidual.A 0 ⊔ T.pairFreeResidual.A 1))
