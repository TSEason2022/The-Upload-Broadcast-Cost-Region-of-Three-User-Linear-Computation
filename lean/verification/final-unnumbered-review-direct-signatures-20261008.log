UploadBroadcast.Task.PrivateTripodChart.mixedDimension_eq_any_lifts : ∀ {K : Type u_1} {F : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] {T : UploadBroadcast.Task K F} (c : T.PrivateTripodChart)
