      UploadBroadcast.ResidualTaskAssembly.pureRows₁ (UploadBroadcast.ResidualTaskAssembly.privateTrim c.toTask) ⊔
          UploadBroadcast.ResidualTaskAssembly.pureRows₂ (UploadBroadcast.ResidualTaskAssembly.privateTrim c.toTask) ⊔
        UploadBroadcast.ResidualTaskAssembly.pureRows₃ (UploadBroadcast.ResidualTaskAssembly.privateTrim c.toTask);
    Module.finrank K
      ↥(Submodule.map (S.mkQ ∘ₗ g.relationRows)
          (LinearMap.ker UploadBroadcast.ResidualTaskAssembly.DemandData.incidence))
