  "project_source_sha256": "6e7af788509fbf182f2830754a8d611c088140f273af1d8a7b16b031ff83a8cd",
  "recorded_utc": "2026-10-08T15:22:31.703958+00:00",
  "runner_source_sha256": "bc4fc9e4fb9cec25fb81132e7dc3f2793037fd271bcff9b33909bdca4eac71c0",
  "runner_source_utf8": "#!/usr/bin/env python3\n\"\"\"Resume one unchanged, fresh-start proof-build campaign after executor loss.\n\nNo proof source is changed, and no project artifact is copied into the campaign.\nAll original gates are rerun. Existing campaign-generated objects are retained.\n\"\"\"\nfrom pathlib import Path\nimport argparse, datetime, fcntl, json, os, platform, shutil, subprocess, sys, time\n\nparser=argparse.ArgumentParser()\nparser.add_argument('project',type=Path)\nparser.add_argument('--expected-source-sha256',required=True)\nargs=parser.parse_args()\nroot=args.project.resolve()\nsys.path.insert(0,str(root/'scripts'))\nfrom release_support import source_manifest,sha256,dump_json,module_inventory\nresults=root/'.verification-results'\nlock=(results/'campaign-continuation.lock').open('a+')\ntry:\n    fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)\nexcept BlockingIOError:\n    raise SystemExit('Another continuation process still holds the campaign lock; refusing overlap.')\nmanifest=json.loads((results/'source-manifest.json').read_text())\nassert manifest['project_source_sha256']==args.expected_source_sha256\nassert source_manifest(root)==manifest,'Frozen source manifest changed before continuation'\nreport=json.loads((results/'report.json').read_text())\nassert not report['passed'] and not report['whole_paper_release_gate_passed']\nassert report['project_compiled_artifacts_reused'] is False\nprior=json.loads((results/'module-build-timings.json').read_text())\ninventory=module_inventory(root)\nassert len(prior)==79 and all(x['exit_code']==0 for x in prior)\nassert [x['module'] for x in prior]==inventory['topological_modules'][:79]\nexpected={'.'.join(Path(p).with_suffix('').parts) for p in []}\nexpected={x['module'] for x in prior}\nobjects=root/'.lake/build/lib/lean'\nfound={'.'.join(p.relative_to(objects).with_suffix('').parts):p for p in objects.rglob('*.olean')}\nassert set(found)==expected, 'Unexpected or missing project objects at recovery boundary'\nartifacts=[]\nfor module in sorted(found):\n    p=found[module]\n    assert not p.is_symlink() and p.resolve().is_relative_to(root)\n    artifacts.append({'module':module,'path':p.relative_to(root).as_posix(),\n                      'sha256':sha256(p.read_bytes()),'size':p.stat().st_size,\n                      'mtime_utc':datetime.datetime.fromtimestamp(p.stat().st_mtime,datetime.timezone.utc).isoformat()})\nfor source,target in [('report.json','pre-continuation-report.json'),\n                      ('module-build-timings.json','pre-continuation-module-build-timings.json'),\n                      ('all-modules.log','pre-continuation-all-modules.log')]:\n    assert not (results/target).exists(), 'Prior continuation evidence already exists; inspect before retrying'\n    shutil.copy2(results/source,results/target)\nrunner=Path(__file__).read_bytes()\nprovenance={'schema_version':1,'event':'executor-interruption-and-continuation',\n    'recorded_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),\n    'original_campaign_started_utc':report['started_utc'],\n    'project_source_sha256':manifest['project_source_sha256'],\n    'source_manifest_matches_before_continuation':True,\n    'interruption_observation':{'original_execution_session':'unavailable after recovery',\n        'last_successful_module_count':79,'next_module':'UploadBroadcast.ReducedTask',\n        'next_module_completed_object_present':False,\n        'visible_matching_build_processes_in_current_executor_namespace':0,\n        'progress_stopped_for_more_than_20_minutes':True,\n        'coordinator_confirmed_executor_recovery_loss':True},\n    'artifacts_retained':artifacts,\n    'artifact_provenance':'All 79 retained project objects were freshly generated inside this same v2 campaign after its empty-build-directory initialization. None were copied from development, the earlier failed snapshot, or the diagnostic tree.',\n    'build_policy':report['build_policy'],\n    'platform_at_continuation':{'system':platform.system(),'architecture':platform.machine(),'python':platform.python_version(),'logical_cpus':os.cpu_count()},\n    'runner_source_utf8':runner.decode(),'runner_source_sha256':sha256(runner),\n    'commands':[],'status':'running'}\ndump_json(results/'continuation-provenance.json',provenance)\nreport['continuation_provenance']='continuation-provenance.json'\nreport['interrupted_campaign']=True\nreport['fresh_campaign_artifacts_retained_on_continuation']=79\nreport['externally_built_project_artifacts_imported']=False\nreport['project_compiled_artifacts_reused_meaning']='No project artifacts from another build campaign were imported. Module dependencies and this recovery reuse only objects freshly built within this same unchanged-source campaign.'\nreport['checks']=[]\nreport['passed']=False\nreport['whole_paper_release_gate_passed']=False\ndump_json(results/'report.json',report)\nchecks=[('toolchain','python3 scripts/verify_toolchain.py --output .verification-results/toolchain.json'),\n ('dependency-pins','python3 scripts/verify_dependency_pins.py --output .verification-results/dependency-pins.json'),\n ('release-regressions','python3 scripts/test_release_tools.py && python3 scripts/test_audit_source.py && python3 scripts/test_package_release.py'),\n ('source-preflight','python3 scripts/audit_source.py && python3 scripts/check_coverage.py'),\n ('all-modules','python3 scripts/check_all_modules.py'),\n ('integrated-check','bash scripts/check.sh'),\n ('complete-coverage','python3 scripts/check_coverage.py')]\nfor name,command in checks:\n    print(f'[CONTINUATION {name}] {command}',flush=True)\n    start=time.monotonic()\n    provenance['commands'].append({'name':name,'command':command,'started_utc':datetime.datetime.now(datetime.timezone.utc).isoformat()})\n    dump_json(results/'continuation-provenance.json',provenance)\n    with (results/(name+'.log')).open('a') as output:\n        output.write('\\n=== Unchanged-source campaign continuation after executor recovery ===\\n')\n        output.flush()\n        process=subprocess.Popen(['bash','-c','set -euo pipefail; source scripts/env.sh; '+command],cwd=root,\n             env=dict(os.environ,LEAN_NUM_THREADS='1',PAPER_RELEASE_THREADS='1'),\n             stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,pass_fds=(lock.fileno(),))\n        try:\n            for line in process.stdout:\n                print(line,end='',flush=True);output.write(line);output.flush()\n            code=process.wait()\n        except KeyboardInterrupt:\n            process.terminate()\n            try:process.wait(timeout=10)\n            except subprocess.TimeoutExpired:process.kill();process.wait()\n            code=130\n    item={'name':name,'command':command,'exit_code':code,\n          'duration_seconds':round(time.monotonic()-start,3),'log':name+'.log'}\n    report['checks'].append(item)\n    provenance['commands'][-1].update({'exit_code':code,'duration_seconds':item['duration_seconds']})\n    dump_json(results/'report.json',report)\n    dump_json(results/'continuation-provenance.json',provenance)\n    if code:\n        provenance['status']='failed'\n        provenance['finished_utc']=datetime.datetime.now(datetime.timezone.utc).isoformat()\n        dump_json(results/'continuation-provenance.json',provenance)\n        print('Continuation gate failed; campaign remains unverified.',flush=True)\n        raise SystemExit(code)\nunchanged=source_manifest(root)==manifest\nreport['source_unchanged_during_checks']=unchanged\nreport['finished_utc']=datetime.datetime.now(datetime.timezone.utc).isoformat()\nreport['passed']=unchanged\nreport['whole_paper_release_gate_passed']=unchanged\nprovenance['source_manifest_matches_after_continuation']=unchanged\nprovenance['status']='passed' if unchanged else 'source-changed'\nprovenance['finished_utc']=report['finished_utc']\ndump_json(results/'continuation-provenance.json',provenance)\ndump_json(results/'report.json',report)\nif not unchanged:raise SystemExit('Frozen source changed; refusing completed release status')\nprint('Interrupted fresh-start campaign completed with all gates passed; source identity '+manifest['project_source_sha256'],flush=True)\n",
  "schema_version": 1,
  "source_manifest_matches_before_continuation": true,
  "status": "running"
}
