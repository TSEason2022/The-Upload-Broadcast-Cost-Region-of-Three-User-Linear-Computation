UploadBroadcast.ResidualComponentAdditivity.finalResidual_uploadValue.{u_1, u_5, u_6, u_7, u_8} {K : Type u_1} [Field K]
  {P₁ : Type u_5} {P₂ : Type u_6} {P₃ : Type u_7} {D : Type u_8} [AddCommGroup P₁] [Module K P₁] [AddCommGroup P₂]
  [Module K P₂] [AddCommGroup P₃] [Module K P₃] [AddCommGroup D] [Module K D] [FiniteDimensional K P₁]
  [FiniteDimensional K P₂] [FiniteDimensional K P₃] [FiniteDimensional K D]
  (T : UploadBroadcast.Task K (UploadBroadcast.ResidualUpload.Ambient P₁ P₂ P₃ D))
