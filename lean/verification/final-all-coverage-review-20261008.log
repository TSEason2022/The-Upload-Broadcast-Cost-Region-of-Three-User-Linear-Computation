UploadBroadcast.NonzeroSameChartMenus.same_chart_all_menu_choices : ∀ {K F : Type} [inst : Field K]
  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] [inst_3 : FiniteDimensional K F] [inst_4 : Fintype K],
  3 ≤ Fintype.card K →
    ∀ (T : UploadBroadcast.Task K F),
      UploadBroadcast.TaskDecomposition.Indecomposable (UploadBroadcast.EdgeExtraction.configuration T).spaces ⊤ →
        ∀ (g : UploadBroadcast.NonzeroDefectProfile.Family) (n : ℕ),
          1 ≤ n →
            UploadBroadcast.NonzeroFamilyRanks.Dimensions T g n →
              ∀ (choice : UploadBroadcast.Three),
                ∃ P,
                  ∃ (hg : T.LocallyGenerated P),
                    T.RelayFeasible P ∧
                      Module.finrank K ↥P =
                          UploadBroadcast.NonzeroDefectProfile.fullAmbient g n -
                            UploadBroadcast.NonzeroDefectProfile.codimension g ∧
                        ↑(Module.finrank K ↥P) = T.uploadOptimum ∧
                          ∑ i, Module.finrank K ↥(P ⊓ T.A i) = Module.finrank K ↥P ∧
                            (∀ (r : Fin 6),
                                UploadBroadcast.Profile.entry (UploadBroadcast.NonzeroDefectRelays.inducedTask T P hg)
                                    (Sum.inl r) =
                                  ↑(UploadBroadcast.NonzeroDefectProfile.fullFirst g n r) +
                                    ↑(UploadBroadcast.NonzeroSameChartMenus.menuIncrement g choice r)) ∧
                              ∀ (i ell : UploadBroadcast.Three),
                                2 *
                                    UploadBroadcast.Profile.entry
                                      (UploadBroadcast.NonzeroDefectRelays.inducedTask T P hg) (Sum.inr (i, ell)) =
                                  ↑(UploadBroadcast.NonzeroDefectProfile.doubledSecond g n)
UploadBroadcast.NonzeroSameChartOptimality.same_chart_full_and_optimal_relay : ∀ {K F : Type} [inst : Field K]
  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] [inst_3 : FiniteDimensional K F] [inst_4 : Fintype K],
  3 ≤ Fintype.card K →
    ∀ (T : UploadBroadcast.Task K F),
      UploadBroadcast.TaskDecomposition.Indecomposable (UploadBroadcast.EdgeExtraction.configuration T).spaces ⊤ →
        ∀ (g : UploadBroadcast.NonzeroDefectProfile.Family) (n : ℕ),
          1 ≤ n →
            UploadBroadcast.NonzeroFamilyRanks.Dimensions T g n →
              (∀ (r : Fin 6),
                  UploadBroadcast.Profile.entry T (Sum.inl r) =
                    ↑(UploadBroadcast.NonzeroDefectProfile.fullFirst g n r)) ∧
                (∀ (i ell : UploadBroadcast.Three),
                    2 * UploadBroadcast.Profile.entry T (Sum.inr (i, ell)) =
                      ↑(UploadBroadcast.NonzeroDefectProfile.doubledSecond g n)) ∧
                  ∃ P,
                    ∃ (hg : T.LocallyGenerated P),
                      T.RelayFeasible P ∧
                        Module.finrank K ↥P =
                            UploadBroadcast.NonzeroDefectProfile.fullAmbient g n -
                              UploadBroadcast.NonzeroDefectProfile.codimension g ∧
                          ↑(Module.finrank K ↥P) = T.uploadOptimum ∧
                            ∑ i, Module.finrank K ↥(P ⊓ T.A i) = Module.finrank K ↥P ∧
                              (∀ (r : Fin 6),
                                  UploadBroadcast.Profile.entry (UploadBroadcast.NonzeroDefectRelays.inducedTask T P hg)
                                      (Sum.inl r) =
                                    ↑(UploadBroadcast.NonzeroDefectProfile.fullFirst g n r) +
                                      ↑(UploadBroadcast.NonzeroDefectProfile.firstIncrement g r)) ∧
                                ∀ (i ell : UploadBroadcast.Three),
                                  2 *
                                      UploadBroadcast.Profile.entry
                                        (UploadBroadcast.NonzeroDefectRelays.inducedTask T P hg) (Sum.inr (i, ell)) =
                                    ↑(UploadBroadcast.NonzeroDefectProfile.doubledSecond g n)
