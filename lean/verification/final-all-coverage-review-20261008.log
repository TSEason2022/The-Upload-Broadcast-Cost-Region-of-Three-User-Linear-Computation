  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] [inst_3 : FiniteDimensional K F]
  (T : UploadBroadcast.Task K F),
  let Q := T.quotientTask T.commonKnown;
  let s := T.selectedPairs;
  (∀ (i : UploadBroadcast.Three), IsCompl (s.passive i) (s.activeFactor i)) ∧
    (∀ (i : UploadBroadcast.Three), Module.finrank K ↥(s.activeFactor i) = T.intrinsicActivePairRank i) ∧
      (∀ (i : UploadBroadcast.Three), Submodule.map (↑s.simultaneous) (Q.A i) = Q.A i) ∧
        ∀ (i : UploadBroadcast.Three),
          Submodule.map (↑(s.chart i).symm) (Submodule.map (↑s.simultaneous) (Q.U i)) =
            (s.activeFactor i).prod
              (Submodule.map (LinearMap.snd K ↥(Q.pairKnown i) ↥(s.residual i))
                (Submodule.map (↑(s.chart i).symm) (Q.U i)))
