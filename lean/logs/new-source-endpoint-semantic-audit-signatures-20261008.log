  let μ := ProbabilityTheory.uniformOn Set.univ;
  let obs := fun A => UploadBroadcast.observe K F A;
  let msg := fun i x => code.encode i (obs (task.A i) x);
  let q := Real.log ↑(Nat.card K);
  let Γ :=
    ↑n *
      (2 * ↑(Module.finrank K ↥(g.R 0 ⊔ g.R 1 ⊔ g.R 2)) -
        (↑(Module.finrank K ↥(g.R 0)) + ↑(Module.finrank K ↥(g.R 1)) + ↑(Module.finrank K ↥(g.R 2))));
  let J :=
    ![I[msg 1 : msg 2|fun x => (obs (g.R 0) x, obs g.O x);μ] / q,
      I[msg 0 : msg 2|fun x => (obs (g.R 1) x, obs g.O x);μ] / q,
      I[msg 0 : msg 1|fun x => (obs (g.R 2) x, obs g.O x);μ] / q];
  ∀ (i j : UploadBroadcast.Three),
    i ≠ j → Γ + J i + J j ≤ H[msg 0 | obs g.O ; μ] / q + H[msg 1 | obs g.O ; μ] / q + H[msg 2 | obs g.O ; μ] / q
