UploadBroadcast.LinearObservation.model_condEntropy_rank : ∀ {K : Type u_1} [inst : Field K] [inst_1 : Finite K]
  {F : Type u_6} [inst_2 : AddCommGroup F] [inst_3 : _root_.Module K F] [inst_4 : FiniteDimensional K F]
