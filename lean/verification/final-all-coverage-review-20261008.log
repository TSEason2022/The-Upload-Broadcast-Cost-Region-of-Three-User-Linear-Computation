UploadBroadcast.RootClassification.classification_iff : ∀ (f u₁ u₂ u₃ a₁ a₂ a₃ : ℤ),
  UploadBroadcast.RootClassification.UpToArmPermutation f u₁ u₂ u₃ a₁ a₂ a₃ ↔
    UploadBroadcast.RootClassification.Legal f u₁ u₂ u₃ a₁ a₂ a₃ ∧
      UploadBroadcast.Structural.tits f u₁ u₂ u₃ a₁ a₂ a₃ = 1 ∧ 0 < UploadBroadcast.Structural.excess f a₁ a₂ a₃
UploadBroadcast.RootClassification.table_legal_thresholds : ∀ (n : ℤ),
  (UploadBroadcast.RootClassification.Legal (3 * n) (2 * n) (2 * n) (2 * n) n n (n + 1) ↔ 1 ≤ n) ∧
    (UploadBroadcast.RootClassification.Legal (3 * n) (2 * n) (2 * n) (2 * n + 1) n n (n + 1) ↔ 1 ≤ n) ∧
      (UploadBroadcast.RootClassification.Legal (3 * n + 1) (2 * n) (2 * n + 1) (2 * n + 1) n (n + 1) (n + 1) ↔ 0 ≤ n) ∧
        (UploadBroadcast.RootClassification.Legal (3 * n + 1) (2 * n + 1) (2 * n + 1) (2 * n + 1) n (n + 1) (n + 1) ↔
            0 ≤ n) ∧
          (UploadBroadcast.RootClassification.Legal (3 * n + 1) (2 * n + 1) (2 * n + 1) (2 * n + 1) (n + 1) (n + 1)
                (n + 1) ↔
              0 ≤ n) ∧
            (UploadBroadcast.RootClassification.Legal (3 * n + 2) (2 * n + 1) (2 * n + 1) (2 * n + 1) (n + 1) (n + 1)
                  (n + 1) ↔
                0 ≤ n) ∧
              (UploadBroadcast.RootClassification.Legal (3 * n + 2) (2 * n + 1) (2 * n + 1) (2 * n + 2) (n + 1) (n + 1)
                    (n + 1) ↔
                  0 ≤ n) ∧
                (UploadBroadcast.RootClassification.Legal (3 * n + 2) (2 * n + 1) (2 * n + 2) (2 * n + 2) (n + 1)
                      (n + 1) (n + 1) ↔
                    0 ≤ n) ∧
                  (UploadBroadcast.RootClassification.Legal (3 * n + 2) (2 * n + 2) (2 * n + 2) (2 * n + 2) (n + 1)
                      (n + 1) (n + 1) ↔
                    0 ≤ n)
UploadBroadcast.ScalarIncidence.projection_lift : ∀ {K : Type u_1} {F : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] (U : Fin 3 → Submodule K F) (i : Fin 3) {r x y z l : ℕ}
  (g : UploadBroadcast.ScalarIncidence.Groups r x y z l),
  ∀ v ∈ UploadBroadcast.ScalarIncidence.allowed U i g, ∃ t, (UploadBroadcast.ScalarIncidence.projection U i g) t = v
UploadBroadcast.ScalarIncidence.projection_mem : ∀ {K : Type u_1} {F : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] (U : Fin 3 → Submodule K F) (i : Fin 3) {r x y z l : ℕ}
  (g : UploadBroadcast.ScalarIncidence.Groups r x y z l) (t : UploadBroadcast.ScalarIncidence.Space U g),
  (UploadBroadcast.ScalarIncidence.projection U i g) t ∈ UploadBroadcast.ScalarIncidence.allowed U i g
UploadBroadcast.Structural.tits_squares : ∀ (f u₁ u₂ u₃ a₁ a₂ a₃ : ℤ),
  4 * UploadBroadcast.Structural.tits f u₁ u₂ u₃ a₁ a₂ a₃ =
    (2 * u₁ - f - a₁) ^ 2 + (2 * u₂ - f - a₂) ^ 2 + (2 * u₃ - f - a₃) ^ 2 + (a₁ - a₂) ^ 2 + (a₁ - a₃) ^ 2 +
        (a₂ - a₃) ^ 2 +
      UploadBroadcast.Structural.excess f a₁ a₂ a₃ ^ 2
UploadBroadcast.Task.Code.exists_upload_only_decoder : ∀ {K : Type u_1} {F : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] {T : UploadBroadcast.Task K F} {L : ℕ}
  {M : UploadBroadcast.Three → Type u_3} {S : Type u_4} (c : T.Code L M S),
  ∃ d,
    ∀ (x : UploadBroadcast.Source K F L) (i : UploadBroadcast.Three),
      (d i (UploadBroadcast.observe K F (T.A i) x) fun j x_1 => c.encode j (UploadBroadcast.observe K F (T.A j) x)) =
        UploadBroadcast.observe K F (T.U i) x
UploadBroadcast.Task.PrivateTripodChart.activeResidual_rows_finrank : ∀ {K : Type u_1} {F : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] {S : UploadBroadcast.Task K F} (c : S.PrivateTripodChart)
  [inst_3 : FiniteDimensional K F],
  let t := UploadBroadcast.ResidualTaskAssembly.privateTrim c.toTask;
  let g := UploadBroadcast.ResidualTaskAssembly.selectedTrimData c.toTask ⋯ ⋯ ⋯;
  let P :=
    UploadBroadcast.ResidualTaskAssembly.pureRows₁ t ⊔ UploadBroadcast.ResidualTaskAssembly.pureRows₂ t ⊔
      UploadBroadcast.ResidualTaskAssembly.pureRows₃ t;
  Module.finrank K ↥g.activeRows =
    Module.finrank K ↥P +
      Module.finrank K
        ↥(Submodule.map (P.mkQ ∘ₗ g.relationRows)
            (LinearMap.ker UploadBroadcast.ResidualTaskAssembly.DemandData.incidence))
UploadBroadcast.Task.PrivateTripodChart.activeResidual_signal_quotients : ∀ {K : Type u_1} {F : Type u_2}
  [inst : Field K] [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] {S : UploadBroadcast.Task K F}
  (c : S.PrivateTripodChart),
  c.activeResidual.U 0 =
      c.activeResidual.A 0 ⊔
        Submodule.map UploadBroadcast.ResidualTaskAssembly.demandLift₁
          (Submodule.map UploadBroadcast.ResidualTaskAssembly.demandQuotient₁ (c.activeResidual.U 0)) ∧
    c.activeResidual.U 1 =
        c.activeResidual.A 1 ⊔
          Submodule.map UploadBroadcast.ResidualTaskAssembly.demandLift₂
            (Submodule.map UploadBroadcast.ResidualTaskAssembly.demandQuotient₂ (c.activeResidual.U 1)) ∧
      c.activeResidual.U 2 =
        c.activeResidual.A 2 ⊔
          Submodule.map UploadBroadcast.ResidualTaskAssembly.demandLift₃
            (Submodule.map UploadBroadcast.ResidualTaskAssembly.demandQuotient₃ (c.activeResidual.U 2))
UploadBroadcast.Task.PrivateTripodChart.mixedDimension_eq_any_lifts : ∀ {K : Type u_1} {F : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] {T : UploadBroadcast.Task K F} (c : T.PrivateTripodChart)
  (g : UploadBroadcast.ResidualTaskAssembly.DemandData (UploadBroadcast.ResidualTaskAssembly.privateTrim c.toTask)),
  c.mixedDimension =
    let S :=
      UploadBroadcast.ResidualTaskAssembly.pureRows₁ (UploadBroadcast.ResidualTaskAssembly.privateTrim c.toTask) ⊔
          UploadBroadcast.ResidualTaskAssembly.pureRows₂ (UploadBroadcast.ResidualTaskAssembly.privateTrim c.toTask) ⊔
        UploadBroadcast.ResidualTaskAssembly.pureRows₃ (UploadBroadcast.ResidualTaskAssembly.privateTrim c.toTask);
