    (∀ (i : UploadBroadcast.Three), Module.finrank K ↥(s.activeFactor i) = T.intrinsicActivePairRank i) ∧
      (∀ (i : UploadBroadcast.Three), Submodule.map (↑s.simultaneous) (Q.A i) = Q.A i) ∧
        ∀ (i : UploadBroadcast.Three),
          Submodule.map (↑(s.chart i).symm) (Submodule.map (↑s.simultaneous) (Q.U i)) =
            (s.activeFactor i).prod
