import UploadBroadcast.QuiverTits

/-!
# Weyl real roots of the affine E6 root lattice

A real root is in the orbit of a simple root under the integral simple
reflections of the affine E6 Cartan matrix. This is not defined by Tits norm.
For nonnegative integral vectors, norm one is proved equivalent to this orbit
predicate by height descent. The proof includes the zero-defect case.
-/
set_option maxHeartbeats 2000000
namespace UploadBroadcast.E6RealRoots
open QuiverRepresentation E6Reflection

abbrev Vector := E6Vertex → ℤ

def norm (d : Vector) : ℤ := ReflectionReduction.tits (vector d)
def simple (s : E6Vertex) : Vector := fun v => if v = s then 1 else 0

def delta : Vector
  | .center => 3
  | .middle _ => 2
  | .outer _ => 1

/-- The Weyl-group orbit of the simple roots, generated by actual integral
simple reflections. No quadratic-form hypothesis occurs in this definition. -/
inductive IsRealRoot : Vector → Prop
  | simple (s : E6Vertex) : IsRealRoot (simple s)
  | reflect (s : E6Vertex) {d : Vector} : IsRealRoot d →
      IsRealRoot (reflectDimension s d)

lemma norm_nonneg (d : Vector) : 0 ≤ norm d := by
  have h := Structural.tits_squares (d .center) (d (.middle 0)) (d (.middle 1))
    (d (.middle 2)) (d (.outer 0)) (d (.outer 1)) (d (.outer 2))
  dsimp [norm,ReflectionReduction.tits,vector]
  nlinarith [sq_nonneg (2*d (.middle 0)-d .center-d (.outer 0)),
    sq_nonneg (2*d (.middle 1)-d .center-d (.outer 1)),
    sq_nonneg (2*d (.middle 2)-d .center-d (.outer 2)),
    sq_nonneg (d (.outer 0)-d (.outer 1)),
    sq_nonneg (d (.outer 0)-d (.outer 2)),
    sq_nonneg (d (.outer 1)-d (.outer 2)),
    sq_nonneg (Structural.excess (d .center) (d (.outer 0)) (d (.outer 1)) (d (.outer 2)))]

lemma norm_zero_kernel (d : Vector) (h : norm d = 0) :
    d = fun v => delta v * d (.outer 0) := by
  have hs := Structural.tits_squares (d .center) (d (.middle 0)) (d (.middle 1))
    (d (.middle 2)) (d (.outer 0)) (d (.outer 1)) (d (.outer 2))
  dsimp [norm,ReflectionReduction.tits,vector] at h
  rw [h] at hs
  have h0 := sq_nonneg (2*d (.middle 0)-d .center-d (.outer 0))
  have h1 := sq_nonneg (2*d (.middle 1)-d .center-d (.outer 1))
  have h2 := sq_nonneg (2*d (.middle 2)-d .center-d (.outer 2))
  have ha := sq_nonneg (d (.outer 0)-d (.outer 1))
  have hb := sq_nonneg (d (.outer 0)-d (.outer 2))
  have hc := sq_nonneg (d (.outer 1)-d (.outer 2))
  have he := sq_nonneg (Structural.excess (d .center) (d (.outer 0)) (d (.outer 1)) (d (.outer 2)))
  have hz0 : 2*d (.middle 0)-d .center-d (.outer 0) = 0 :=
    sq_eq_zero_iff.mp (by omega)
  have hz1 : 2*d (.middle 1)-d .center-d (.outer 1) = 0 :=
    sq_eq_zero_iff.mp (by omega)
  have hz2 : 2*d (.middle 2)-d .center-d (.outer 2) = 0 :=
    sq_eq_zero_iff.mp (by omega)
  have hza : d (.outer 0)-d (.outer 1) = 0 := sq_eq_zero_iff.mp (by omega)
  have hzb : d (.outer 0)-d (.outer 2) = 0 := sq_eq_zero_iff.mp (by omega)
  have hze : Structural.excess (d .center) (d (.outer 0)) (d (.outer 1)) (d (.outer 2)) = 0 :=
    sq_eq_zero_iff.mp (by omega)
  unfold Structural.excess at hze
  funext v
  cases v with
  | center => simp only [delta]; omega
  | middle i =>
    fin_cases i
    · change d (.middle 0) = 2*d (.outer 0); omega
    · change d (.middle 1) = 2*d (.outer 0); omega
    · change d (.middle 2) = 2*d (.outer 0); omega
  | outer i =>
    fin_cases i
    · change d (.outer 0) = 1*d (.outer 0); omega
    · change d (.outer 1) = 1*d (.outer 0); omega
    · change d (.outer 2) = 1*d (.outer 0); omega

lemma norm_zero_of_zero_coordinate (d : Vector) (h : norm d = 0)
    (s : E6Vertex) (hs : d s = 0) : d = 0 := by
  have hk := norm_zero_kernel d h
  have he := congrFun hk s
  have hz : d (.outer 0) = 0 := by
    rw [hs] at he
    cases s <;> simp only [delta] at he <;> omega
  rw [hz] at hk
  simpa using hk

lemma norm_reflect (s : E6Vertex) (d : Vector) :
    norm (reflectDimension s d) = norm d := by
  cases s with
  | center => simp [norm,ReflectionReduction.tits,vector,Structural.tits,
      reflectDimension,neighbourSum]; ring
  | middle i => fin_cases i <;> simp [norm,ReflectionReduction.tits,vector,Structural.tits,
      reflectDimension,neighbourSum] <;> ring
  | outer i => fin_cases i <;> simp [norm,ReflectionReduction.tits,vector,Structural.tits,
      reflectDimension,neighbourSum] <;> ring

lemma reflect_involutive (s : E6Vertex) (d : Vector) :
    reflectDimension s (reflectDimension s d) = d := by
  funext v
  cases s <;> cases v <;> simp [reflectDimension,neighbourSum]
  all_goals split_ifs <;> simp_all

lemma norm_simple (s : E6Vertex) : norm (simple s) = 1 := by
  cases s with
  | center => decide
  | middle i => fin_cases i <;> decide
  | outer i => fin_cases i <;> decide

/-- Every vector with a Weyl reflection certificate has Tits norm one. -/
theorem IsRealRoot.norm_one {d : Vector} (h : IsRealRoot d) : norm d = 1 := by
  induction h with
  | simple s => exact norm_simple s
  | reflect s h ih => rw [norm_reflect,ih]

lemma neighbourSum_nonneg (d : Vector) (hd : ∀ v, 0 ≤ d v) (s : E6Vertex) :
    0 ≤ neighbourSum d s := by
  cases s with
  | center => exact add_nonneg (add_nonneg (hd _) (hd _)) (hd _)
  | middle i => exact add_nonneg (hd _) (hd _)
  | outer i => exact hd _

lemma norm_clear (s : E6Vertex) (d : Vector) :
    norm d = norm (Function.update d s 0) + d s * (d s - neighbourSum d s) := by
  cases s with
  | center => simp [norm,ReflectionReduction.tits,vector,Structural.tits,
      Function.update,neighbourSum]; ring
  | middle i => fin_cases i <;> simp [norm,ReflectionReduction.tits,vector,Structural.tits,
      Function.update,neighbourSum] <;> ring
  | outer i => fin_cases i <;> simp [norm,ReflectionReduction.tits,vector,Structural.tits,
      Function.update,neighbourSum] <;> ring

lemma gradient_sum (d : Vector) :
    ∑ v, d v * (2*d v-neighbourSum d v) = 2*norm d := by
  simp [sum_vertices,neighbourSum,norm,ReflectionReduction.tits,vector,Structural.tits]
  ring

lemma sum_reflect (s : E6Vertex) (d : Vector) :
    ∑ v, reflectDimension s d v = (∑ v, d v) + neighbourSum d s - 2*d s := by
  cases s with
  | center => simp [sum_vertices,reflectDimension,neighbourSum]; ring
  | middle i => fin_cases i <;> simp [sum_vertices,reflectDimension,neighbourSum] <;> ring
  | outer i => fin_cases i <;> simp [sum_vertices,reflectDimension,neighbourSum] <;> ring

lemma exists_positive_gradient (d : Vector) (hd : ∀ v, 0 ≤ d v)
    (hq : norm d = 1) : ∃ s, 0 < 2*d s-neighbourSum d s := by
  by_contra hn
  push_neg at hn
  have hs : (∑ v, d v * (2*d v-neighbourSum d v)) ≤ 0 :=
    Finset.sum_nonpos (fun v _ => mul_nonpos_of_nonneg_of_nonpos (hd v) (hn v))
  rw [gradient_sum,hq] at hs
  omega

/-- A norm-one nonnegative vector whose reflection would have a negative
coordinate is already the corresponding simple root. -/
lemma simple_of_dominant_coordinate (d : Vector) (hd : ∀ v, 0 ≤ d v)
    (hq : norm d = 1) (s : E6Vertex) (hs : neighbourSum d s < d s) :
    d = simple s := by
  have hn := neighbourSum_nonneg d hd s
  have hx : 1 ≤ d s := by omega
  have hp : d s ≤ d s*(d s-neighbourSum d s) := by
    have hm := mul_nonneg (hd s) (show 0 ≤ d s-neighbourSum d s-1 by omega)
    nlinarith
  have hc := norm_clear s d
  have hqc := norm_nonneg (Function.update d s 0)
  have hv : d s = 1 := by omega
  have hns : neighbourSum d s = 0 := by omega
  have hzc : norm (Function.update d s 0) = 0 := by
    rw [hq,hv,hns] at hc
    omega
  have hz := norm_zero_of_zero_coordinate (Function.update d s 0) hzc s (by simp)
  funext v
  by_cases hvs : v = s
  · subst v
    simp [simple,hv]
  · have h := congrFun hz v
    simpa [Function.update,hvs,simple] using h

/-- Height descent constructs a finite simple-reflection certificate for every
nonnegative integral norm-one vector of affine E6. -/
theorem realRoot_of_nonneg_norm_one (d : Vector) (hd : ∀ v, 0 ≤ d v)
    (hq : norm d = 1) : IsRealRoot d := by
  classical
  generalize hh : (∑ v, d v).toNat = n
  induction n using Nat.strong_induction_on generalizing d with
  | h n ih =>
    obtain ⟨s,hs⟩ := exists_positive_gradient d hd hq
    by_cases hdom : neighbourSum d s < d s
    · rw [simple_of_dominant_coordinate d hd hq s hdom]
      exact IsRealRoot.simple s
    · have he : ∀ v, 0 ≤ reflectDimension s d v := by
        intro v
        by_cases hv : v = s
        · subst v
          simp only [reflectDimension,if_pos rfl]
          omega
        · simpa [reflectDimension,hv] using hd v
      have heq : norm (reflectDimension s d) = 1 := (norm_reflect s d).trans hq
      have hsum : (∑ v, reflectDimension s d v) < ∑ v, d v := by
        rw [sum_reflect]
        omega
      have hpos : 0 < ∑ v, d v := lt_of_le_of_lt
        (Finset.sum_nonneg (fun v _ => he v)) hsum
      have hlt : (∑ v, reflectDimension s d v).toNat < n := by
        rw [← hh]
        exact (Int.toNat_lt_toNat hpos).mpr hsum
      have hr := ih _ hlt (reflectDimension s d) he heq rfl
      have hr' := IsRealRoot.reflect s hr
      rwa [reflect_involutive] at hr'

/-- Tits norm one and Weyl real-root membership are equivalent on the
nonnegative affine E6 lattice; this equivalence is proved, not assumed. -/
theorem nonnegative_realRoot_iff_norm_one (d : Vector) (hd : ∀ v, 0 ≤ d v) :
    IsRealRoot d ↔ norm d = 1 :=
  ⟨IsRealRoot.norm_one,realRoot_of_nonneg_norm_one d hd⟩

end UploadBroadcast.E6RealRoots
