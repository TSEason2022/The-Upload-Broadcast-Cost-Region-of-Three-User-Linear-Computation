  (∀ (v : UploadBroadcast.QuiverRepresentation.E6Vertex), 0 ≤ d v) →
    (UploadBroadcast.E6RealRoots.IsRealRoot d ↔ UploadBroadcast.E6RealRoots.norm d = 1)
UploadBroadcast.EdgeDeficits.demand_cycles_from_decomposition : ∀ {K : Type u_1} {V : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup V] [inst_2 : _root_.Module K V] [inst_3 : FiniteDimensional K V] {G : Type u_3}
  [inst_4 : AddCommGroup G] [inst_5 : _root_.Module K G] [inst_6 : FiniteDimensional K G] (T : UploadBroadcast.Task K V)
  (L : List ℕ) (M : UploadBroadcast.Task K G) (e : (UploadBroadcast.EdgeDeficits.ResonantAmbient K L × V) ≃ₗ[K] G),
  UploadBroadcast.Profile.mapTask e
        (UploadBroadcast.Profile.directSum (UploadBroadcast.EdgeDeficits.resonantTask K L) T) =
      M →
    ∀ (p : Equiv.Perm UploadBroadcast.Three) (D : ℝ),
      UploadBroadcast.Profile.rankBound M ≤ D →
        ∃ r v Q,
          max 0 (↑L.length - UploadBroadcast.EdgeDeficits.orientationSlack M p D) ≤ ↑r ∧
            (LinearIndependent K fun x => v x.fst x.snd) ∧
              (∀ (a : UploadBroadcast.Three),
                  UploadBroadcast.EdgeExtraction.EdgeBlock T ((UploadBroadcast.EdgeDeficits.cyclicPerm p a) 0)
                      ((UploadBroadcast.EdgeDeficits.cyclicPerm p a) 1)
                      ((UploadBroadcast.EdgeDeficits.cyclicPerm p a) 2) (Submodule.span K (Set.range (v a))) ∧
                    Module.finrank K ↥(Submodule.span K (Set.range (v a))) = r) ∧
                UploadBroadcast.TaskDecomposition.Split (UploadBroadcast.EdgeExtraction.configuration T).spaces ⊤ Q
                  (⨆ a, Submodule.span K (Set.range (v a)))
UploadBroadcast.EdgeExtraction.simultaneous_maximal_extraction : ∀ {K : Type u_1} {V : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup V] [inst_2 : _root_.Module K V] [inst_3 : FiniteDimensional K V]
  (T : UploadBroadcast.Task K V),
  ∃ Q W,
    iSupIndep W ∧
      UploadBroadcast.TaskDecomposition.Split (UploadBroadcast.EdgeExtraction.configuration T).spaces ⊤ Q (⨆ e, W e) ∧
        (∀ (e : UploadBroadcast.EdgeExtraction.Edge),
            UploadBroadcast.EdgeExtraction.EdgeBlock T (↑e).1 (↑e).2.1 (↑e).2.2 (W e) ∧
              Module.finrank K ↥(W e) = UploadBroadcast.EdgeExtraction.multiplicity T (↑e).1 (↑e).2.1 (↑e).2.2) ∧
          ∀ (l : Fin 3 × Bool),
            (UploadBroadcast.EdgeExtraction.configuration T).spaces l =
              (UploadBroadcast.EdgeExtraction.configuration T).spaces l ⊓ Q ⊔
                ⨆ e, (UploadBroadcast.EdgeExtraction.configuration T).spaces l ⊓ W e
UploadBroadcast.EdgeProfile.edge_price_identity : ∀ {K : Type u_1} {F : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] [inst_3 : FiniteDimensional K F] (T : UploadBroadcast.Task K F)
  (i j k : UploadBroadcast.Three),
  T.U 0 ⊓ T.U 1 ⊓ T.U 2 = T.U i ⊓ T.U j ⊓ T.U k →
    UploadBroadcast.Profile.firstEntry T i j k + UploadBroadcast.Profile.firstEntry T j k i -
        2 * UploadBroadcast.Profile.secondEntry T j i k k =
      ↑(UploadBroadcast.condRank (T.A k ⊓ T.U j) (T.A j ⊔ T.U i ⊓ T.U j)) -
        ↑(UploadBroadcast.condRank (T.U j ⊓ T.U k ⊓ (T.A j ⊔ T.U i ⊓ T.U j))
            (T.U i ⊓ T.U j ⊓ T.U k ⊔ T.A k ⊓ (T.A j ⊔ T.U i ⊓ T.U j)))
UploadBroadcast.EdgeProfile.edge_price_le_extractable : ∀ {K : Type u_1} {F : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] [inst_3 : FiniteDimensional K F] (T : UploadBroadcast.Task K F)
  (p : Equiv.Perm UploadBroadcast.Three),
  UploadBroadcast.Profile.firstEntry T (p 0) (p 1) (p 2) + UploadBroadcast.Profile.firstEntry T (p 1) (p 2) (p 0) -
      2 * UploadBroadcast.Profile.secondEntry T (p 1) (p 0) (p 2) (p 2) ≤
    ↑(UploadBroadcast.EdgeExtraction.multiplicity T (p 0) (p 1) (p 2))
UploadBroadcast.Examples.fixed_broadcast_cost : ∀ (L : ℕ),
  0 < L → Real.logb 2 ↑(Fintype.card ↑(Set.range UploadBroadcast.Examples.fixedBroadcast)) / ↑L = 2
UploadBroadcast.Examples.fixed_relay_broadcast_cost_lower : ∀ {L : ℕ},
  0 < L →
    ∀ {S : Type u_1} [inst : Fintype S] [inst : DecidableEq S] (b : UploadBroadcast.Examples.RelayInput L → S)
      (d2 d3 :
        S →
          UploadBroadcast.Examples.BitBlock L →
            UploadBroadcast.Examples.BitBlock L → UploadBroadcast.Examples.BitBlock L),
      (∀ (a u x c v : UploadBroadcast.Examples.BitBlock L),
          d2 (b (a, u, x, c)) x v = UploadBroadcast.Examples.xorBlock a c) →
        (∀ (a u x c v : UploadBroadcast.Examples.BitBlock L),
            d3 (b (a, u, x, c)) c (UploadBroadcast.Examples.xorBlock u v) =
              UploadBroadcast.Examples.xorBlock (UploadBroadcast.Examples.xorBlock a x) u) →
          2 ≤ Real.logb 2 ↑(Fintype.card ↑(Set.range b)) / ↑L
UploadBroadcast.Examples.two_instance_achievability : (∀
    (s : UploadBroadcast.Examples.BitSource × UploadBroadcast.Examples.BitSource),
    UploadBroadcast.Examples.decode1 (UploadBroadcast.Examples.broadcast2 s)
          (UploadBroadcast.Examples.side1 s.1, UploadBroadcast.Examples.side1 s.2) =
        (UploadBroadcast.Examples.demand1 s.1, UploadBroadcast.Examples.demand1 s.2) ∧
      UploadBroadcast.Examples.decode2 (UploadBroadcast.Examples.broadcast2 s)
            (UploadBroadcast.Examples.side2 s.1, UploadBroadcast.Examples.side2 s.2) =
          (UploadBroadcast.Examples.demand2 s.1, UploadBroadcast.Examples.demand2 s.2) ∧
        UploadBroadcast.Examples.decode3 (UploadBroadcast.Examples.broadcast2 s)
            (UploadBroadcast.Examples.side3 s.1, UploadBroadcast.Examples.side3 s.2) =
          (UploadBroadcast.Examples.demand3 s.1, UploadBroadcast.Examples.demand3 s.2)) ∧
  UploadBroadcast.Examples.twoInstanceUploadCost = 4 ∧ UploadBroadcast.Examples.twoInstanceBroadcastCost = 3 / 2
UploadBroadcast.FiniteAlphabet.commonFunction : ∀ {Ω : Type u_1} {ι : Type u_2} [inst : MeasurableSpace Ω]
  [inst_1 : Fintype ι] [inst_2 : DecidableEq ι] {α : ι → Type u_3} [inst_3 : (i : ι) → Fintype (α i)]
  [inst_4 : (i : ι) → MeasurableSpace (α i)] [inst_5 : ∀ (i : ι), MeasurableSingletonClass (α i)]
  (μ : MeasureTheory.Measure Ω) [inst_6 : MeasureTheory.IsProbabilityMeasure μ] (X : Ω → (i : ι) → α i),
  Measurable X →
    ∀ (Y₁ Y₂ Y₃ T₁ T₂ T₃ M₁ M₂ M₃ Θ O : Finset ι),
      ProbabilityTheory.CondIndepFun (UploadBroadcast.FiniteAlphabet.project (Y₁ ∪ T₁) ∘ X)
          (UploadBroadcast.FiniteAlphabet.project (Y₂ ∪ T₂) ∘ X) (UploadBroadcast.FiniteAlphabet.project O ∘ X) μ →
        ProbabilityTheory.CondIndepFun (UploadBroadcast.FiniteAlphabet.project (Y₁ ∪ T₁) ∘ X)
            (UploadBroadcast.FiniteAlphabet.project (Y₃ ∪ T₃) ∘ X) (UploadBroadcast.FiniteAlphabet.project O ∘ X) μ →
          ProbabilityTheory.CondIndepFun (UploadBroadcast.FiniteAlphabet.project (Y₂ ∪ T₂) ∘ X)
              (UploadBroadcast.FiniteAlphabet.project (Y₃ ∪ T₃) ∘ X) (UploadBroadcast.FiniteAlphabet.project O ∘ X) μ →
            UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X M₁ (Y₁ ∪ T₁ ∪ O) = 0 →
              UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X M₂ (Y₂ ∪ T₂ ∪ O) = 0 →
                UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X M₃ (Y₃ ∪ T₃ ∪ O) = 0 →
                  UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X Y₁ (M₁ ∪ T₁ ∪ O) = 0 →
                    UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X Y₂ (M₂ ∪ T₂ ∪ O) = 0 →
                      UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X Y₃ (M₃ ∪ T₃ ∪ O) = 0 →
                        UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X T₃ (T₁ ∪ T₂ ∪ O) = 0 →
                          UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X T₂ (T₁ ∪ T₃ ∪ O) = 0 →
                            UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X Θ (M₁ ∪ M₂ ∪ M₃ ∪ T₁ ∪ O) = 0 →
                              UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X Θ (M₁ ∪ M₂ ∪ M₃ ∪ T₂ ∪ O) = 0 →
                                UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X T₁ (M₁ ∪ M₂ ∪ M₃ ∪ Θ ∪ T₃ ∪ O) =
                                    0 →
                                  2 *
                                            UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X
                                              (Y₁ ∪ T₁ ∪ (Y₂ ∪ T₂) ∪ (Y₃ ∪ T₃)) O -
                                          (UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X (Y₁ ∪ T₁) O +
                                              UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X (Y₂ ∪ T₂) O +
                                            UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X (Y₃ ∪ T₃) O) +
                                        UploadBroadcast.FiniteAlphabet.conditionalMutualInformation μ X M₂ M₃
                                          (M₁ ∪ T₁ ∪ O) +
                                      UploadBroadcast.FiniteAlphabet.conditionalMutualInformation μ X M₁ M₃
                                        (M₂ ∪ T₂ ∪ O) ≤
                                    UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X M₁ O +
                                        UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X M₂ O +
                                      UploadBroadcast.FiniteAlphabet.conditionalEntropy μ X M₃ O
UploadBroadcast.FiniteAlphabet.omniscience_lift : ∀ {Ω : Type u_1} {ι : Type u_2} [inst : MeasurableSpace Ω]
  [inst_1 : Fintype ι] [inst_2 : DecidableEq ι] {α : ι → Type u_3} [inst_3 : (i : ι) → Fintype (α i)]
  [inst_4 : (i : ι) → MeasurableSpace (α i)] [inst_5 : ∀ (i : ι), MeasurableSingletonClass (α i)]
  (μ : MeasureTheory.Measure Ω) [inst_6 : MeasureTheory.IsProbabilityMeasure μ] (X : Ω → (i : ι) → α i),
  Measurable X →
    ∀ (O S₁ S₂ S₃ R₁ R₂ R₃ M₁ M₂ M₃ : Finset ι) (Γ : ℝ),
      ProbabilityTheory.IndepFun (UploadBroadcast.FiniteAlphabet.project O ∘ X)
          (UploadBroadcast.FiniteAlphabet.project (R₁ ∪ R₂ ∪ R₃) ∘ X) μ →
        ProbabilityTheory.IndepFun (UploadBroadcast.FiniteAlphabet.project R₁ ∘ X)
            (UploadBroadcast.FiniteAlphabet.project R₂ ∘ X) μ →
          ProbabilityTheory.IndepFun (UploadBroadcast.FiniteAlphabet.project R₁ ∘ X)
              (UploadBroadcast.FiniteAlphabet.project R₃ ∘ X) μ →
            ProbabilityTheory.IndepFun (UploadBroadcast.FiniteAlphabet.project R₂ ∘ X)
                (UploadBroadcast.FiniteAlphabet.project R₃ ∘ X) μ →
              H[UploadBroadcast.FiniteAlphabet.project S₁ ∘ X | UploadBroadcast.FiniteAlphabet.project O ∘ X ; μ] = 0 →
                H[UploadBroadcast.FiniteAlphabet.project S₂ ∘ X | UploadBroadcast.FiniteAlphabet.project O ∘ X ; μ] =
                    0 →
                  H[UploadBroadcast.FiniteAlphabet.project S₃ ∘ X | UploadBroadcast.FiniteAlphabet.project O ∘ X ; μ] =
                      0 →
                    H[UploadBroadcast.FiniteAlphabet.project M₁ ∘ X |
                          UploadBroadcast.FiniteAlphabet.project (S₁ ∪ R₁) ∘ X ; μ] =
                        0 →
                      H[UploadBroadcast.FiniteAlphabet.project M₂ ∘ X |
                            UploadBroadcast.FiniteAlphabet.project (S₂ ∪ R₂) ∘ X ; μ] =
                          0 →
                        H[UploadBroadcast.FiniteAlphabet.project M₃ ∘ X |
                              UploadBroadcast.FiniteAlphabet.project (S₃ ∪ R₃) ∘ X ; μ] =
                            0 →
                          H[UploadBroadcast.FiniteAlphabet.project O ∘ X |
                                UploadBroadcast.FiniteAlphabet.project (R₁ ∪ S₁ ∪ M₂ ∪ M₃) ∘ X ; μ] =
                              0 →
                            H[UploadBroadcast.FiniteAlphabet.project O ∘ X |
                                  UploadBroadcast.FiniteAlphabet.project (R₂ ∪ S₂ ∪ M₁ ∪ M₃) ∘ X ; μ] =
                                0 →
                              H[UploadBroadcast.FiniteAlphabet.project O ∘ X |
                                    UploadBroadcast.FiniteAlphabet.project (R₃ ∪ S₃ ∪ M₁ ∪ M₂) ∘ X ; μ] =
                                  0 →
                                Γ +
                                        I[UploadBroadcast.FiniteAlphabet.project M₂ ∘ X :
                                          UploadBroadcast.FiniteAlphabet.project M₃ ∘
                                            X|UploadBroadcast.FiniteAlphabet.project (R₁ ∪ O) ∘ X;μ] +
                                      I[UploadBroadcast.FiniteAlphabet.project M₁ ∘ X :
                                        UploadBroadcast.FiniteAlphabet.project M₃ ∘
                                          X|UploadBroadcast.FiniteAlphabet.project (R₂ ∪ O) ∘ X;μ] ≤
                                    H[UploadBroadcast.FiniteAlphabet.project M₁ ∘ X |
                                          UploadBroadcast.FiniteAlphabet.project O ∘ X ; μ] +
                                        H[UploadBroadcast.FiniteAlphabet.project M₂ ∘ X |
                                          UploadBroadcast.FiniteAlphabet.project O ∘ X ; μ] +
                                      H[UploadBroadcast.FiniteAlphabet.project M₃ ∘ X |
                                        UploadBroadcast.FiniteAlphabet.project O ∘ X ; μ] →
                                  Γ +
                                          I[UploadBroadcast.FiniteAlphabet.project M₂ ∘ X :
                                            UploadBroadcast.FiniteAlphabet.project M₃ ∘
                                              X|UploadBroadcast.FiniteAlphabet.project (R₁ ∪ O) ∘ X;μ] +
                                        I[UploadBroadcast.FiniteAlphabet.project M₁ ∘ X :
                                          UploadBroadcast.FiniteAlphabet.project M₂ ∘
                                            X|UploadBroadcast.FiniteAlphabet.project (R₃ ∪ O) ∘ X;μ] ≤
                                      H[UploadBroadcast.FiniteAlphabet.project M₁ ∘ X |
                                            UploadBroadcast.FiniteAlphabet.project O ∘ X ; μ] +
                                          H[UploadBroadcast.FiniteAlphabet.project M₂ ∘ X |
                                            UploadBroadcast.FiniteAlphabet.project O ∘ X ; μ] +
                                        H[UploadBroadcast.FiniteAlphabet.project M₃ ∘ X |
                                          UploadBroadcast.FiniteAlphabet.project O ∘ X ; μ] →
                                    Γ +
                                            I[UploadBroadcast.FiniteAlphabet.project M₁ ∘ X :
                                              UploadBroadcast.FiniteAlphabet.project M₃ ∘
                                                X|UploadBroadcast.FiniteAlphabet.project (R₂ ∪ O) ∘ X;μ] +
                                          I[UploadBroadcast.FiniteAlphabet.project M₁ ∘ X :
                                            UploadBroadcast.FiniteAlphabet.project M₂ ∘
                                              X|UploadBroadcast.FiniteAlphabet.project (R₃ ∪ O) ∘ X;μ] ≤
                                        H[UploadBroadcast.FiniteAlphabet.project M₁ ∘ X |
                                              UploadBroadcast.FiniteAlphabet.project O ∘ X ; μ] +
                                            H[UploadBroadcast.FiniteAlphabet.project M₂ ∘ X |
                                              UploadBroadcast.FiniteAlphabet.project O ∘ X ; μ] +
                                          H[UploadBroadcast.FiniteAlphabet.project M₃ ∘ X |
                                            UploadBroadcast.FiniteAlphabet.project O ∘ X ; μ] →
                                      Γ +
                                          max
                                            (max
                                              H[UploadBroadcast.FiniteAlphabet.project O ∘ X |
                                                UploadBroadcast.FiniteAlphabet.project S₁ ∘ X ; μ]
                                              (max
                                                H[UploadBroadcast.FiniteAlphabet.project O ∘ X |
                                                  UploadBroadcast.FiniteAlphabet.project S₂ ∘ X ; μ]
                                                H[UploadBroadcast.FiniteAlphabet.project O ∘ X |
                                                  UploadBroadcast.FiniteAlphabet.project S₃ ∘ X ; μ]))
                                            ((H[UploadBroadcast.FiniteAlphabet.project O ∘ X |
                                                    UploadBroadcast.FiniteAlphabet.project S₁ ∘ X ; μ] +
                                                  H[UploadBroadcast.FiniteAlphabet.project O ∘ X |
                                                    UploadBroadcast.FiniteAlphabet.project S₂ ∘ X ; μ] +
                                                H[UploadBroadcast.FiniteAlphabet.project O ∘ X |
                                                  UploadBroadcast.FiniteAlphabet.project S₃ ∘ X ; μ]) /
                                              2) ≤
                                        H[UploadBroadcast.FiniteAlphabet.project M₁ ∘ X ; μ] +
                                            H[UploadBroadcast.FiniteAlphabet.project M₂ ∘ X ; μ] +
                                          H[UploadBroadcast.FiniteAlphabet.project M₃ ∘ X ; μ]
