UploadBroadcast.ResidualComponentAdditivity.residual_decomposition.{u_1, u_2, u_4, u_5} {K : Type u_1} {F : Type u_2}
  {I : Type u_4} [Field K] [AddCommGroup F] [Module K F] [Finite K] [FiniteDimensional K F] {G : I → Type u_5}
  [Fintype I] [(i : I) → AddCommGroup (G i)] [(i : I) → Module K (G i)] [∀ (i : I), FiniteDimensional K (G i)]
  (T : UploadBroadcast.Task K F) (S : (i : I) → UploadBroadcast.Task K (G i)) (e : ((i : I) → G i) ≃ₗ[K] F)
  (he : UploadBroadcast.Profile.mapTask e (UploadBroadcast.FiniteRelayAssembly.task S) = T)
  (h : UploadBroadcast.ResidualComponentAdditivity.ActiveResidual T) :
  (∀ (i : I), UploadBroadcast.ResidualComponentAdditivity.ActiveResidual (S i)) ∧
    T.uploadOptimum = UploadBroadcast.ResidualComponentAdditivity.uploadValue T ∧
      (∀ (i : I), (S i).uploadOptimum = UploadBroadcast.ResidualComponentAdditivity.uploadValue (S i)) ∧
        T.uploadOptimum = ∑ i, (S i).uploadOptimum
UploadBroadcast.ResidualComponentAdditivity.exists_indecomposable_residual_decomposition.{u_1, u_2} {K : Type u_1}
  {F : Type u_2} [Field K] [AddCommGroup F] [Module K F] [Finite K] [FiniteDimensional K F]
  (T : UploadBroadcast.Task K F) (h : UploadBroadcast.ResidualComponentAdditivity.ActiveResidual T) :
  ∃ n P e,
    UploadBroadcast.Profile.mapTask e
          (UploadBroadcast.FiniteRelayAssembly.task (UploadBroadcast.FiniteComponentCoordinates.componentTask T P e)) =
        T ∧
      (∀ (i : Fin n),
          UploadBroadcast.TaskDecomposition.Indecomposable
            (UploadBroadcast.EdgeExtraction.configuration
                (UploadBroadcast.FiniteComponentCoordinates.componentTask T P e i)).spaces
            ⊤) ∧
        (∀ (i : Fin n) (j : UploadBroadcast.Three),
            (UploadBroadcast.FiniteComponentCoordinates.componentTask T P e i).A j =
              Submodule.comap (P i).subtype (T.A j)) ∧
          (∀ (i : Fin n) (j : UploadBroadcast.Three),
              (UploadBroadcast.FiniteComponentCoordinates.componentTask T P e i).U j =
                Submodule.comap (P i).subtype (T.U j)) ∧
            (∀ (i : Fin n),
                UploadBroadcast.ResidualComponentAdditivity.ActiveResidual
                  (UploadBroadcast.FiniteComponentCoordinates.componentTask T P e i)) ∧
              T.uploadOptimum = UploadBroadcast.ResidualComponentAdditivity.uploadValue T ∧
                (∀ (i : Fin n),
                    (UploadBroadcast.FiniteComponentCoordinates.componentTask T P e i).uploadOptimum =
                      UploadBroadcast.ResidualComponentAdditivity.uploadValue
                        (UploadBroadcast.FiniteComponentCoordinates.componentTask T P e i)) ∧
                  T.uploadOptimum =
                      ∑ i, (UploadBroadcast.FiniteComponentCoordinates.componentTask T P e i).uploadOptimum ∧
                    ∑ i, Module.finrank K ↥(P i) = Module.finrank K F
UploadBroadcast.ResidualComponentAdditivity.source_residual_decomposition.{u_1, u_2} {K : Type u_1} {F : Type u_2}
  [Field K] [AddCommGroup F] [Module K F] [Finite K] [FiniteDimensional K F] (T : UploadBroadcast.Task K F) :
  ∃ n P e,
    UploadBroadcast.Profile.mapTask e
          (UploadBroadcast.FiniteRelayAssembly.task
            (UploadBroadcast.FiniteComponentCoordinates.componentTask T.pairFreeChart.componentResidual P e)) =
        T.pairFreeChart.componentResidual ∧
      (∀ (i : Fin n),
          UploadBroadcast.TaskDecomposition.Indecomposable
            (UploadBroadcast.EdgeExtraction.configuration
                (UploadBroadcast.FiniteComponentCoordinates.componentTask T.pairFreeChart.componentResidual P e
                  i)).spaces
            ⊤) ∧
        (∀ (i : Fin n) (j : UploadBroadcast.Three),
            (UploadBroadcast.FiniteComponentCoordinates.componentTask T.pairFreeChart.componentResidual P e i).A j =
              Submodule.comap (P i).subtype (T.pairFreeChart.componentResidual.A j)) ∧
          (∀ (i : Fin n) (j : UploadBroadcast.Three),
              (UploadBroadcast.FiniteComponentCoordinates.componentTask T.pairFreeChart.componentResidual P e i).U j =
                Submodule.comap (P i).subtype (T.pairFreeChart.componentResidual.U j)) ∧
            (∀ (i : Fin n),
                UploadBroadcast.ResidualComponentAdditivity.ActiveResidual
                  (UploadBroadcast.FiniteComponentCoordinates.componentTask T.pairFreeChart.componentResidual P e i)) ∧
              T.pairFreeChart.componentResidual.uploadOptimum =
                  UploadBroadcast.ResidualComponentAdditivity.uploadValue T.pairFreeChart.componentResidual ∧
                (∀ (i : Fin n),
                    (UploadBroadcast.FiniteComponentCoordinates.componentTask T.pairFreeChart.componentResidual P e
                          i).uploadOptimum =
                      UploadBroadcast.ResidualComponentAdditivity.uploadValue
                        (UploadBroadcast.FiniteComponentCoordinates.componentTask T.pairFreeChart.componentResidual P e
                          i)) ∧
                  T.pairFreeChart.componentResidual.uploadOptimum =
                      ∑ i,
                        (UploadBroadcast.FiniteComponentCoordinates.componentTask T.pairFreeChart.componentResidual P e
                            i).uploadOptimum ∧
                    ∑ i, Module.finrank K ↥(P i) =
                      Module.finrank K
                        (UploadBroadcast.ResidualUpload.Ambient
                          ↥(UploadBroadcast.ResidualTaskAssembly.used₁ T.pairFreeChart.toTask)
                          ↥(UploadBroadcast.ResidualTaskAssembly.used₂ T.pairFreeChart.toTask)
                          ↥(UploadBroadcast.ResidualTaskAssembly.used₃ T.pairFreeChart.toTask)
                          ↥(UploadBroadcast.ResidualTaskAssembly.finalDemandData T.pairFreeChart.toTask ⋯ ⋯
                                ⋯).activeRows)
UploadBroadcast.ResidualComponentAdditivity.source_residual_upload_formula.{u_1, u_2} {K : Type u_1} {F : Type u_2}
  [Field K] [AddCommGroup F] [Module K F] [Finite K] [FiniteDimensional K F] (T : UploadBroadcast.Task K F) :
  T.pairFreeChart.componentResidual.uploadOptimum =
    ↑(UploadBroadcast.ResidualTaskAssembly.privateDimension T.pairFreeChart.toTask) +
      ↑(UploadBroadcast.ResidualTaskAssembly.tripodDimension T.pairFreeChart.toTask ⋯ ⋯ ⋯)
UploadBroadcast.ResidualComponentAdditivity.zero_excess_full_relay.{u_1, u_2} {K : Type u_1} {F : Type u_2} [Field K]
  [AddCommGroup F] [Module K F] [FiniteDimensional K F] [Finite K] (T : UploadBroadcast.Task K F)
  (h : UploadBroadcast.ResidualComponentAdditivity.ActiveResidual T)
  (hz : Module.finrank K ↥(T.A 0) + Module.finrank K ↥(T.A 1) + Module.finrank K ↥(T.A 2) = Module.finrank K F) :
  T.uploadOptimum = ↑(Module.finrank K F) ∧
    T.LocallyGenerated ⊤ ∧
      T.RelayFeasible ⊤ ∧
        ∀ (r : UploadBroadcast.Profile.Index),
          UploadBroadcast.Profile.entry (T.inducedRelay ⊤ ⋯) r = UploadBroadcast.Profile.entry T r
