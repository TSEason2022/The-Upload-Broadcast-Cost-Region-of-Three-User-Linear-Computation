UploadBroadcast.Task.intrinsic_upload_parameters : ∀ {K : Type u_1} {F : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] [inst_3 : Finite K] [inst_4 : FiniteDimensional K F]
  (T : UploadBroadcast.Task K F) (s u : (T.quotientTask T.commonKnown).ActivePairSelection)
  (t : s.pairReducedTask.ActivePairSelection) (v : u.pairReducedTask.ActivePairSelection)
  (c : t.pairResidualTask.PrivateTripodChart) (d : v.pairResidualTask.PrivateTripodChart),
  (∀ (i : UploadBroadcast.Three),
      Module.finrank K ↥(s.pairReducedTask.pairKnown i) = T.intrinsicActivePairRank i ∧
        Module.finrank K ↥(u.pairReducedTask.pairKnown i) = T.intrinsicActivePairRank i) ∧
    c.privateDimension = d.privateDimension ∧
      c.commonDimension = d.commonDimension ∧
        c.pureDimension = d.pureDimension ∧
          c.mixedDimension = d.mixedDimension ∧
            c.tripodDimension = d.tripodDimension ∧
              c.uploadFormula (T.intrinsicActivePairRank 0) (T.intrinsicActivePairRank 1)
                  (T.intrinsicActivePairRank 2) =
                T.minimumUploadFormula
