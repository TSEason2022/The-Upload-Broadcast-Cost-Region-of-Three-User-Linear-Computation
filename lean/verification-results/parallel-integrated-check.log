    T.A 1 = UploadBroadcast.ResidualUpload.A₂ K P₁ P₂ P₃ D →
      T.A 2 = UploadBroadcast.ResidualUpload.A₃ K P₁ P₂ P₃ D →
        UploadBroadcast.ResidualComponentAdditivity.ActiveResidual T →
