UploadBroadcast.ResidualComponentAdditivity.exists_indecomposable_residual_decomposition : ∀ {K : Type u_1}
  {F : Type u_2} [inst : Field K] [inst_1 : AddCommGroup F] [inst_2 : _root_.Module K F] [inst_3 : Finite K]
  [inst_4 : FiniteDimensional K F] (T : UploadBroadcast.Task K F),
  UploadBroadcast.ResidualComponentAdditivity.ActiveResidual T →
    ∃ n P e,
      UploadBroadcast.Profile.mapTask e
            (UploadBroadcast.FiniteRelayAssembly.task
              (UploadBroadcast.FiniteComponentCoordinates.componentTask T P e)) =
          T ∧
        (∀ (i : Fin n),
            UploadBroadcast.TaskDecomposition.Indecomposable
              (UploadBroadcast.EdgeExtraction.configuration
                  (UploadBroadcast.FiniteComponentCoordinates.componentTask T P e i)).spaces
              ⊤) ∧
          (∀ (i : Fin n) (j : UploadBroadcast.Three),
              (UploadBroadcast.FiniteComponentCoordinates.componentTask T P e i).A j =
                Submodule.comap (P i).subtype (T.A j)) ∧
            (∀ (i : Fin n) (j : UploadBroadcast.Three),
                (UploadBroadcast.FiniteComponentCoordinates.componentTask T P e i).U j =
                  Submodule.comap (P i).subtype (T.U j)) ∧
              (∀ (i : Fin n),
                  UploadBroadcast.ResidualComponentAdditivity.ActiveResidual
                    (UploadBroadcast.FiniteComponentCoordinates.componentTask T P e i)) ∧
                T.uploadOptimum = UploadBroadcast.ResidualComponentAdditivity.uploadValue T ∧
                  (∀ (i : Fin n),
                      (UploadBroadcast.FiniteComponentCoordinates.componentTask T P e i).uploadOptimum =
                        UploadBroadcast.ResidualComponentAdditivity.uploadValue
                          (UploadBroadcast.FiniteComponentCoordinates.componentTask T P e i)) ∧
                    T.uploadOptimum =
                        ∑ i, (UploadBroadcast.FiniteComponentCoordinates.componentTask T P e i).uploadOptimum ∧
                      ∑ i, Module.finrank K ↥(P i) = Module.finrank K F
