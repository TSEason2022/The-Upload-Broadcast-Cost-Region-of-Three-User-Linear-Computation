  (task : UploadBroadcast.Task K (UploadBroadcast.ResidualUpload.Ambient P₁ P₂ P₃ D))
  (h₁ : task.A 0 = UploadBroadcast.ResidualUpload.A₁ K P₁ P₂ P₃ D)
  (h₂ : task.A 1 = UploadBroadcast.ResidualUpload.A₂ K P₁ P₂ P₃ D)
  (h₃ : task.A 2 = UploadBroadcast.ResidualUpload.A₃ K P₁ P₂ P₃ D) : UploadBroadcast.SignalBridge.Data
UploadBroadcast.ResidualTaskAssembly.canonicalReduction_common_pure_eq_bot.{u_1, u_4, u_5, u_6, u_7} {K : Type u_1}
  [Field K] {P₁ : Type u_4} {P₂ : Type u_5} {P₃ : Type u_6} {D : Type u_7} [AddCommGroup P₁] [Module K P₁]
