  [inst_10 : FiniteDimensional K X₁] [inst_11 : FiniteDimensional K X₂] [inst_12 : FiniteDimensional K X₃]
  [inst_13 : Finite K], ∃ r₁ r₂ r₃ c, c.alphabetCost / 2 = UploadBroadcast.Omniscience.optimum
UploadBroadcast.Omniscience.nonempty_code_iff : ∀ {K : Type u_1} {V : Type u_2} [inst : Field K]
  [inst_1 : AddCommGroup V] [inst_2 : _root_.Module K V] {X₁ : Type u_5} {X₂ : Type u_6} {X₃ : Type u_7}
  [inst_3 : AddCommGroup X₁] [inst_4 : _root_.Module K X₁] [inst_5 : AddCommGroup X₂] [inst_6 : _root_.Module K X₂]
  [inst_7 : AddCommGroup X₃] [inst_8 : _root_.Module K X₃] [inst_9 : FiniteDimensional K V]
  [inst_10 : FiniteDimensional K X₁] [inst_11 : FiniteDimensional K X₂] [inst_12 : FiniteDimensional K X₃]
