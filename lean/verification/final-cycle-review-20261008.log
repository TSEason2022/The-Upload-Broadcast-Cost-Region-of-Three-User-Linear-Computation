def UploadBroadcast.CycleSourceEndpoint.Repair.{u_1, u_2} : {K : Type u_1} →
  {F : Type u_2} →
    [inst : Field K] →
      [inst_1 : Finite K] →
        [inst_2 : AddCommGroup F] →
          [inst_3 : Module K F] → [inst_4 : FiniteDimensional K F] → UploadBroadcast.Task K F → ℕ → Fin 6 → Prop :=
fun {K} {F} [Field K] [Finite K] [AddCommGroup F] [Module K F] [FiniteDimensional K F] T d target =>
  ∃ P,
    ∃ (hl : T.LocallyGenerated P),
      T.RelayFeasible P ∧
        Module.finrank K ↥P = d ∧
          ↑(Module.finrank K ↥P) = T.uploadOptimum ∧
            (∀ (r : Fin 6),
                UploadBroadcast.Profile.entry (UploadBroadcast.NonzeroDefectRelays.inducedTask T P hl) (Sum.inl r) =
                  UploadBroadcast.Profile.entry T (Sum.inl r) + if r = target then 1 else 0) ∧
              (∀ (i l : UploadBroadcast.Three),
                  UploadBroadcast.Profile.entry (UploadBroadcast.NonzeroDefectRelays.inducedTask T P hl)
                      (Sum.inr (i, l)) =
                    UploadBroadcast.Profile.entry T (Sum.inr (i, l))) ∧
                ∃ uploads c, ∑ i, uploads i = d ∧ c.toCode.uploadCost = ↑d
